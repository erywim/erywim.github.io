---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import Panel from '@/components/famicom/Panel.astro'
import { site } from '@/data/site'

const { giscus } = site
const ready = Boolean(giscus.repoId && giscus.categoryId)
---

<FamicomLayout title='留言板'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '留言板' }]} />

  <CmdMenu active='guestbook' />

  <Panel title='冒险者留言板' en='GUESTBOOK' class='reveal'>
    <div class='intro'>
      「欢迎来到<b>冒险者留言板</b>——一张悬挂在酒馆门前的羊皮纸，途经的旅人都愿在此留下自己的名号与寄语。」
    </div>
    {
      ready ? (
        <script
          is:inline
          src='https://giscus.app/client.js'
          data-repo={giscus.repo}
          data-repo-id={giscus.repoId}
          data-category={giscus.category}
          data-category-id={giscus.categoryId}
          data-mapping='pathname'
          data-strict='0'
          data-reactions-enabled='0'
          data-emit-metadata='0'
          data-input-position='bottom'
          data-theme='https://erywim.github.io/giscus-theme.json'
          data-lang='zh-CN'
          crossorigin='anonymous'
          async
        />
      ) : (
        <div class='empty'>
          <b>GUESTBOOK · OFFLINE</b>
          留言板尚未开放。站长正在架设传送门（giscus），请稍后再来～
        </div>
      )
    }
  </Panel>

  <Dialogue
    speaker='酒馆老板娘'
    avatar
    sprite='miku'
    class='reveal'
    typewriter='远道而来的勇者，提笔写下你的见闻吧。愿你的足迹，能成为后来者的指引。'
  />
</FamicomLayout>
