---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import Search from '@/components/famicom/Search.astro'
import { site } from '@/data/site'
---

<FamicomLayout title='站内搜索'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '站内搜索' }]} />

  <div class='page-head'>
    <h1>站内<b>搜索</b></h1>
    <span class='en'>SEARCH</span>
  </div>

  <CmdMenu />

  <Search />

  <Dialogue speaker={site.heroName}>
    想找哪段冒险？输入关键词，我把对应的任务卷轴翻出来给你。
  </Dialogue>
</FamicomLayout>
