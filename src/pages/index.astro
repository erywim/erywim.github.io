  const btn = document.getElementById('fortuneBtn') as HTMLButtonElement
  const cup = document.getElementById('fortuneCup')
  const res = document.getElementById('fortuneResult') as HTMLElement
  let t: ReturnType<typeof setTimeout> | null = null

  function sparkle(el: HTMLElement, count: number, color?: string) {
    const c = document.createElement('span')
    c.className = 'burst'
    for (let i = 0; i < count; i++) {
      const s = document.createElement('i')
      s.style.setProperty('--dx', (Math.random() * 100 - 50).toFixed(0) + 'px')
      s.style.setProperty('--dy', (Math.random() * 80 - 60).toFixed(0) + 'px')
      s.style.setProperty('--rot', (Math.random() * 360).toFixed(0) + 'deg')
      if (color) s.style.background = color
      c.appendChild(s)
    }
    el.appendChild(c)
    setTimeout(() => c.parentNode?.removeChild(c), 900)
  }

  function flash(at: HTMLElement) {
    const f = document.createElement('span')
    f.className = 'fortune-flash'
    at.appendChild(f)
    setTimeout(() => f.parentNode?.removeChild(f), 600)
  }

  function typeDesc(el: HTMLElement | null) {
    if (!el) return
    const full = el.textContent || ''
    el.textContent = ''
    let i = 0
    const cur = document.createElement('span')
    cur.className = 'cur'
    el.appendChild(cur)
    const timer = setInterval(() => {
      if (!cur.isConnected) {
        clearInterval(timer)
        return
      }
      if (i < full.length) cur.insertAdjacentText('beforebegin', full[i++])
      else clearInterval(timer)
    }, 22)
  }

  // 生成薯条盒里的薯条
  function buildFries() {
    const wrap = document.querySelector<SVGGElement>('.fortune-cup .fries')
    if (!wrap) return
    const xs = [7, 10, 13, 16, 19, 22, 25]
    const hs = [11, 9, 12, 10, 8, 11, 7]
    let s = ''
    for (let i = 0; i < xs.length; i++) {
      const x = xs[i]
      const h = hs[i]
      const y = 13 - h
      const col = i % 2 ? '#e0881a' : '#f2a620'
      s += `<g class="fry"><rect x="${x}" y="${y}" width="2" height="1" fill="#c96f12"/><rect x="${x}" y="${y + 1}" width="2" height="${h - 1}" fill="${col}"/></g>`
    }
    wrap.innerHTML = s
  }

  // 一根薯条从薯条盒飞向结果
  function flyFry(fromRect: DOMRect, toRect: DOMRect, cb: () => void) {
    const w = 10
    const h = 24
    const el = document.createElement('div')
    el.className = 'fly-fry'
    el.style.left = fromRect.left + fromRect.width / 2 - w / 2 + 'px'
    el.style.top = fromRect.top + fromRect.height / 2 - h / 2 + 'px'
    const fx = toRect.left + toRect.width / 2 - (fromRect.left + fromRect.width / 2)
    const fy = toRect.top - (fromRect.top + fromRect.height / 2)
    el.style.setProperty('--fx', fx + 'px')
    el.style.setProperty('--fy', fy + 'px')
    document.body.appendChild(el)
    el.addEventListener('animationend', () => {
      if (el.parentNode) el.parentNode.removeChild(el)
      if (cb) cb()
    })
  }

  function draw() {
    const f = FORTUNES[Math.floor(Math.random() * FORTUNES.length)]
    res.className = 'fortune-result show'
    res.innerHTML =
      `<div class="type ${f.k}">${f.t}</div>` +
      `<div class="yi">${f.yi}</div>` +
      `<div class="ji">${f.ji}</div>` +
      `<div class="desc">${f.desc}</div>` +
      '<button class="again">再抽一次 ↻</button>'
    res.querySelector('.again')?.addEventListener('click', go)
    // 展开动画：一根薯条从盒里飞向结果，随后展开 + 逐行显现 + 火花
    res.classList.add('unfolding')
    const rr = res.getBoundingClientRect()
    const cr = cup?.getBoundingClientRect()
    function openResult() {
      res.classList.remove('unfolding')
      res.classList.add('open')
      typeDesc(res.querySelector('.desc'))
      if (f.k === 'red') {
        sparkle(res, 12, 'var(--gold)')
        sparkle(res, 6, 'var(--accent)')
      } else if (f.k === 'cyan') {
        sparkle(res, 8, 'var(--cyan)')
      } else if (f.k === 'gold') {
        sparkle(res, 5, 'var(--gold)')
      } else {
        sparkle(res, 2, 'var(--dim)')
      }
    }
    if (cr) flyFry(cr, rr, openResult)
    else setTimeout(openResult, 60)
  }

  function go() {
    if (btn.disabled) return
    btn.disabled = true
    btn.textContent = '摇晃中…'
    buildFries()
    cup?.classList.add('shake', 'shaking')
    res.classList.remove('show')
    if (t) clearTimeout(t)
    t = setTimeout(() => {
      cup?.classList.remove('shake', 'shaking')
      cup?.classList.add('jolt')
      if (cup) flash(cup)
      btn.disabled = false
      btn.textContent = '抽薯条 ▶ START'
      draw()
      setTimeout(() => cup?.classList.remove('jolt'), 600)
    }, 620)
  }

  buildFries()

  btn.addEventListener('click', go)
  cup?.addEventListener('click', go)
  cup?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      go()
    }
  })
</script>

<script>
  // —— 道具袋：随机两件收藏 + 「换一批」重掷 ——
  const td = document.getElementById('treasure-data')
  const bagList = document.getElementById('bagList')
  const bagReroll = document.getElementById('bagReroll')
  if (td && td.textContent && bagList && bagReroll) {
    type BagTag = { id: string; name: string; cat: string }
    type BagItem = {
      id: string
      icon: string
      rarity: string
      from: string
      title: string
      desc: string
      tags: string[]
      href: string
    }
    let data: { tags: BagTag[]; items: BagItem[] } | null = null
    try {
      data = JSON.parse(td.textContent)
    } catch {}

    if (data && data.items.length) {
      const tagMap: Record<string, BagTag> = Object.fromEntries(data.tags.map((t) => [t.id, t]))
      const esc = (s: string) =>
        String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string))

      const card = (it: BagItem) => {
        const tags = it.tags
          .map((t) => (tagMap[t] ? `<span class="vtag cat-${tagMap[t].cat}">${esc(tagMap[t].name)}</span>` : ''))
          .join('')
        const meta = `稀有度 ${it.rarity}${it.from ? ' · ' + esc(it.from) : ''}`
        const title = it.href
          ? `<a href="${esc(it.href)}" target="_blank" rel="noopener">${esc(it.title)}</a>`
          : esc(it.title)
        const btn = it.href
          ? `<a class="primary" href="${esc(it.href)}" target="_blank" rel="noopener">打开 ↩</a>`
          : `<span class="primary">待读</span>`
        return `<div class="item-card" data-od-id="bag-${esc(it.id)}">
          <div class="item-icon"><svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true"><use href="#${it.icon}"/></svg></div>
          <div style="min-width:0">
            <div class="it">${meta}</div>
            <h3>${title}</h3>
            <p>${esc(it.desc)}</p>
            <div class="tags">${tags}</div>
            <div class="btns">${btn}<a href="/treasure">宝箱库 →</a></div>
          </div>
        </div>`
      }

      const draw = () => {
        const list = data!.items
        const a = list[Math.floor(Math.random() * list.length)]
        let b = list[Math.floor(Math.random() * list.length)]
        if (list.length > 1 && b.id === a.id) {
          b = list[(list.indexOf(a) + 1 + Math.floor(Math.random() * (list.length - 1))) % list.length]
        }
        bagList.innerHTML = card(a) + (b.id !== a.id ? card(b) : '')
      }

      bagReroll.addEventListener('click', draw)
    }
  }
</script>
