<script>
  // —— PRESS START → 展开薯条占卜 ——
  const ps = document.getElementById('pressStart')
  if (ps) ps.addEventListener('click', openFry)

  // —— 打字机对话框（由 Dialogue.astro 全局处理）——

  // —— 冒险档案数字滚动 ——
  const ach = document.querySelector('.achieve-rows')
  if (ach && 'IntersectionObserver' in window) {
    const aio = new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return
          const box = e.target
          box.querySelectorAll('[data-count]').forEach((n) => {
            const el = n as HTMLElement
            const target = Number(el.dataset.count)
            const t0 = performance.now()
            function step(ts: number) {
              const p = Math.min((ts - t0) / 700, 1)
              el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))))
              if (p < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
          })
          aio.unobserve(box)
        })
      },
      { threshold: 0.4 }
    )
    aio.observe(ach)
  }

  // —— 点主角冒气泡 + 连点 5 次开启彩蛋占卜 ——
  let GU = 0
  const msgs = ['咕♪', '咕咕♪', '咕咕咕♪', '咕咕咕咕♪', '咕咕咕咕咕！']
  document.querySelectorAll('[data-gu]').forEach((zone) => {
    zone.addEventListener('click', () => {
      zone.querySelectorAll('.gu-bubble').forEach((b) => b.parentNode?.removeChild(b))
      GU++
      const b = document.createElement('span')
      b.className = 'gu-bubble'
      b.textContent = GU >= 5 ? '咕咕咕咕咕！彩蛋开启！' : msgs[GU - 1]
      zone.appendChild(b)
      setTimeout(() => b.parentNode?.removeChild(b), 900)
      if (GU >= 5) {
        GU = 0
        openFry()
      }
    })
  })

  // —— 彩蛋弹窗开关 ——
  const fm = document.getElementById('fryModal')
  function openFry() {
    if (!fm) return
    const rs = document.getElementById('fortuneResult')
    if (rs) rs.classList.remove('show', 'open', 'unfolding')
    const fb = document.getElementById('fortuneBtn') as HTMLButtonElement | null
    if (fb) {
      fb.disabled = false
      fb.textContent = '抽薯条 ▶ START'
    }
    fm.classList.add('show')
    fm.setAttribute('aria-hidden', 'false')
    if (fb) setTimeout(() => fb.focus(), 60)
  }
  function closeFry() {
    if (!fm) return
    fm.classList.remove('show')
    fm.setAttribute('aria-hidden', 'true')
    const cup = document.getElementById('fortuneCup')
    if (cup) cup.classList.remove('shake', 'shaking', 'jolt')
  }
  const fc = document.getElementById('fryClose')
  if (fc) fc.addEventListener('click', closeFry)
  if (fm) {
    fm.addEventListener('click', (e) => {
      if (e.target === fm) closeFry()
    })
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fm && fm.classList.contains('show')) closeFry()
  })

