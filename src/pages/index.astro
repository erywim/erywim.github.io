---
import { getCollection } from 'astro:content'

import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import FishSprite from '@/components/famicom/FishSprite.astro'
import Panel from '@/components/famicom/Panel.astro'
import QuestItem from '@/components/famicom/QuestItem.astro'
import Timeline from '@/components/famicom/Timeline.astro'
import TreasureData from '@/components/famicom/TreasureData.astro'
import { party } from '@/data/home'
import { hero } from '@/data/hero'
import { site } from '@/data/site'
import { getTitleForLevel } from '@/data/titles'
import { tagById } from '@/data/treasure'
import { getPublishedBlog } from '@/utils/collections'
import { getMetrics } from '@/utils/metrics'
import { getRpgStats } from '@/utils/rpg'
import { hpAt, mpAt } from '@/utils/vitals'

const posts = await getPublishedBlog()
const { essays, notes, logs } = await getMetrics()
const { gold, exp, level } = getRpgStats(posts)
const title = getTitleForLevel(level)

// 探索地图统计（按文章 category）
const catCounts = new Map<string, number>()
for (const p of posts) catCounts.set(p.data.category, (catCounts.get(p.data.category) ?? 0) + 1)
const exploreTags = [...catCounts.entries()]
  .filter(([c]) => c !== '笔记')
  .map(([c, n]) => ({ name: c, n }))
const noteTag = [...catCounts.entries()].find(([c]) => c === '笔记')

// 体力随时间递减（构建期静态兜底，客户端实时刷新）；HP/MP 曲线不同，EXP 条为距下一级进度
const hpNow = hpAt(new Date())
const mpNow = mpAt(new Date())
const expBar = exp % 100

// 道具袋：从全部收藏里随机取两件（客户端「换一批」重新抽取）
const allTreasure = await getCollection('treasure')
const bagItems = [...allTreasure].sort(() => Math.random() - 0.5).slice(0, 2)
---

<FamicomLayout>
  <header class='title-screen'>
    <div class='stars'>★ ★ ★</div>
    <div class='game-title'><span class='r'>{site.gameTitleR}</span><span class='g'>{site.gameTitleG}</span></div>
    <div class='title-sprite-zone' data-gu>
      <span class='fish'>
        <FishSprite width={120} height={64} label='红鲤勇者' />
      </span>
    </div>
    <p class='subtitle'>{site.tagline}</p>
    <div class='press-start' id='pressStart'>▶ PRESS START ◀</div>
  </header>

  <CmdMenu />

  <Panel title='状态' en='STATUS' id='status' class='reveal' link='/about' linkLabel='勇者档案 →'>
    <div class='status-body'>
      <div class='status-avatar'>
        <FishSprite width={96} height={51} label='玩家头像' />
      </div>
      <div>
        <div class='status-name'>{site.heroName}</div>
        <div class='status-title'>称号「<span data-rpg-title>{title}</span>」</div>
        <div class='status-class'>{hero.class}</div>
        <div class='stat-row'><span class='k'>HP</span><span class='v' data-live-hp>{hpNow}</span><span class='stat-bar hp'><i data-live-hp-bar style={`--w:${hpNow}%`}></i></span></div>
        <div class='stat-row'><span class='k'>MP</span><span class='v' data-live-mp>{mpNow}</span><span class='stat-bar mp'><i data-live-mp-bar style={`--w:${mpNow}%`}></i></span></div>
        <div class='stat-row'><span class='k'>EXP</span><span class='v' data-stat='exp'>{exp}</span><span class='stat-bar exp'><i style={`--w:${expBar}%`}></i></span></div>
        <div class='stat-meta'>
          <span>攻击 <b>长文×{essays}</b></span><span>防御 <b>笔记×{notes}</b></span><span>金币 <b data-stat='gold' data-lite>G{gold}</b></span>
        </div>
      </div>
      {
        hero.buffs.length > 0 && (
          <div class='status-fx'>
            <div class='fx-title'>状态效果 <span class='en'>BUFF</span></div>
            {
              hero.buffs.map((buff) => (
                <div class='fx-row'>
                  <svg class='fx-ic' width='18' height='18' viewBox='0 0 10 10' shape-rendering='crispEdges' aria-hidden='true'><use href={`#pix-buff-${buff.icon}`}/></svg>
                  <span class='fx-name'>{buff.name}</span>
                  <div class={`fx-bar ${buff.kind}`}><i style={`width:${buff.width}%`}></i></div>
                  <span class='fx-val'>{buff.val}</span>
                </div>
              ))
            }
          </div>
        )
      }
    </div>
  </Panel>

  <Panel title='冒险记录' en='QUEST LOG' id='quests' class='reveal' link='/blog' linkLabel='全部冒险 →'>
    <ul class='quest-list'>
      {
        posts.map((post, i) => (
          <QuestItem {post} index={i} variant='home' />
        ))
      }
    </ul>
    {
      posts.length === 0 && (
        <p style='padding:14px 16px;color:var(--dim)'>暂无任务。</p>
      )
    }
  </Panel>

  <div class='grid-2'>
    <Panel title='道具袋' en='ITEMS' id='items' class='reveal'>
      <div slot='actions' class='px-actions'>
        <button class='px-refresh' id='bagReroll' type='button'>换一批 ↻</button>
        <a class='px-link' href='/treasure'>打开宝箱 →</a>
      </div>
      <div class='bag-list' id='bagList'>
        {
          bagItems.length > 0 ? (
            bagItems.map((item) => (
              <div class='item-card' data-od-id={`bag-${item.id}`}>
                <div class='item-icon'>
                  <svg viewBox='0 0 16 16' shape-rendering='crispEdges' aria-hidden='true'><use href={`#${item.data.icon}`}/></svg>
                </div>
                <div style='min-width:0'>
                  <div class='it'>稀有度 {item.data.rarity}{item.data.from ? ` · ${item.data.from}` : ''}</div>
                  <h3>
                    {
                      item.data.href ? (
                        <a href={item.data.href} target='_blank' rel='noopener'>{item.data.title}</a>
                      ) : (
                        item.data.title
                      )
                    }
                  </h3>
                  <p>{item.data.desc}</p>
                  <div class='tags'>
                    {item.data.tags.map((t) => <span class={`vtag cat-${tagById[t].cat}`}>{tagById[t].name}</span>)}
                  </div>
                  <div class='btns'>
                    {
                      item.data.href ? (
                        <a class='primary' href={item.data.href} target='_blank' rel='noopener'>打开 ↩</a>
                      ) : (
                        <span class='primary'>待读</span>
                      )
                    }
                    <a href='/treasure'>宝箱库 →</a>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <p style='padding:14px 16px;color:var(--dim)'>还没有收集任何道具。</p>
          )
        }
      </div>
    </Panel>

    <Panel title='存档' en='SAVE' id='party' class='reveal' link='/about' linkLabel='勇者档案 →'>
      <div class='party-grid'>
        {
          party.map((member) => (
            <div class='party-card'>
              <div class='party-av'>
                {
                  member.avatar === 'warrior' ? (
                    <svg width='48' height='48' viewBox='0 0 24 24' shape-rendering='crispEdges' aria-hidden='true'>
                      <rect x='9' y='2' width='6' height='4' fill='#f0a030'/><rect x='8' y='6' width='8' height='6' fill='#ff2b35'/><rect x='10' y='12' width='4' height='2' fill='#f2f5ff'/><rect x='8' y='14' width='8' height='6' fill='#1d2c4d'/><rect x='6' y='20' width='4' height='2' fill='#0e1526'/><rect x='14' y='20' width='4' height='2' fill='#0e1526'/>
                    </svg>
                  ) : (
                    <svg width='48' height='48' viewBox='0 0 24 24' shape-rendering='crispEdges' aria-hidden='true'>
                      <rect x='9' y='2' width='6' height='4' fill='#33d5ff'/><rect x='8' y='6' width='8' height='6' fill='#1d2c4d'/><rect x='10' y='12' width='4' height='2' fill='#f2f5ff'/><rect x='8' y='14' width='8' height='6' fill='#33d5ff'/><rect x='6' y='20' width='4' height='2' fill='#0e1526'/><rect x='14' y='20' width='4' height='2' fill='#0e1526'/><rect x='18' y='8' width='2' height='6' fill='#f8d878'/>
                    </svg>
                  )
                }
              </div>
              <div class='party-main'>
                <h3>{member.title}</h3>
                <div class='cls'>{member.class}</div>
                <p>{member.desc}</p>
                <div class='period'>{member.period}</div>
                <div class='tags'>
                  {member.chips.map((chip) => <span class='vtag cat-domain'>{chip}</span>)}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Panel>
  </div>

  <Panel title='冒险档案' en='ACHIEVEMENTS' class='reveal'>
    <div class='achieve-rows'>
      <div class='achieve-row'>
        <div class='ar-title'>
          冒险记录 <span class='en'>ADVENTURES</span>
          <a class='px-link' href='/blog'>冒险记录 →</a>
        </div>
        <div class='ar-stats'>
          <div class='ar-stat'><b data-count={essays}>0</b> 长文</div>
          <div class='ar-stat'><b data-count={notes}>0</b> 笔记</div>
          <div class='ar-stat'><b data-count={essays + notes}>0</b> 文章</div>
        </div>
        {
          (exploreTags.length > 0 || noteTag) && (
            <div class='ar-tags'>
              <span>✍️ 探索地图：</span>
              {exploreTags.map((t) => <span class='tag'>{t.name} {t.n}</span>)}
              {noteTag && (
                <>
                  <span>·</span><span>📓 笔记：</span><span class='tag'>{noteTag[0]} {noteTag[1]}</span>
                </>
              )}
            </div>
          )
        }
      </div>
      <div class='achieve-row'>
        <div class='ar-title'>
          旅行日志 <span class='en'>JOURNEY</span>
          <a class='px-link' href='/logs'>旅行日志 →</a>
        </div>
        <div class='ar-stats'>
          <div class='ar-stat'><b data-count={logs}>0</b> 日志</div>
        </div>
      </div>
    </div>
  </Panel>

  <Timeline />

  <Dialogue
    speaker={site.heroName}
    avatar
    class='reveal'
    typewriter='欢迎来到我的冒险世界。我是全栈 Agent 开发工程师，正在用代码探索这片星海。用下面的命令菜单逛逛我的旅程吧。'
  />

  <div id='fryModal' aria-hidden='true'>
    <div class='fm-panel' role='dialog' aria-modal='true' aria-label='隐藏彩蛋·薯条占卜'>
      <button class='fm-close' id='fryClose' aria-label='关闭'>✕</button>
      <div class='fm-title'>◆ 隐藏彩蛋 · 薯条占卜</div>
