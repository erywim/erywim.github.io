---
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import FishSprite from '@/components/famicom/FishSprite.astro'
import Panel from '@/components/famicom/Panel.astro'
import QuestItem from '@/components/famicom/QuestItem.astro'
import { items, party } from '@/data/home'
import { hero } from '@/data/hero'
import { site } from '@/data/site'
import { getPublishedBlog } from '@/utils/collections'
import { getMetrics } from '@/utils/metrics'

const posts = await getPublishedBlog()
const { total, essays, notes, logs } = await getMetrics()

// 探索地图统计（按文章 category）
const catCounts = new Map<string, number>()
for (const p of posts) catCounts.set(p.data.category, (catCounts.get(p.data.category) ?? 0) + 1)
const exploreTags = [...catCounts.entries()]
  .filter(([c]) => c !== '笔记')
  .map(([c, n]) => ({ name: c, n }))
const noteTag = [...catCounts.entries()].find(([c]) => c === '笔记')

const hpW = hero.stats.hp.max ? Math.round((hero.stats.hp.value / hero.stats.hp.max) * 100) : 0
const mpW = hero.stats.mp.max ? Math.round((hero.stats.mp.value / hero.stats.mp.max) * 100) : 0
const expW = hero.stats.exp.max ? Math.round((hero.stats.exp.value / hero.stats.exp.max) * 100) : 0
---

<FamicomLayout>
  <header class='title-screen'>
    <div class='stars'>★ ★ ★</div>
    <div class='game-title'><span class='r'>{site.gameTitleR}</span><span class='g'>{site.gameTitleG}</span></div>
    <div class='title-sprite-zone' data-gu>
      <span class='fish'>
        <FishSprite width={120} height={64} label='红鲤勇者' />
      </span>
    </div>
    <p class='subtitle'>{site.tagline}</p>
    <div class='press-start' id='pressStart'>▶ PRESS START ◀</div>
  </header>

  <CmdMenu />

  <div class='grid-2'>
    <Panel title='状态' en='STATUS' id='status' class='reveal' link='/about' linkLabel='勇者档案 →'>
      <div class='status-body'>
        <div class='status-avatar'>
          <FishSprite width={96} height={51} label='玩家头像' />
        </div>
        <div>
          <div class='status-name'>{site.heroName}</div>
          <div class='status-class'>{hero.class}</div>
          <div class='stat-row'><span class='k'>HP</span><span class='v'>{hero.stats.hp.value}</span><span class='stat-bar hp'><i style={`--w:${hpW}%`}></i></span></div>
          <div class='stat-row'><span class='k'>MP</span><span class='v'>{hero.stats.mp.value}</span><span class='stat-bar mp'><i style={`--w:${mpW}%`}></i></span></div>
          <div class='stat-row'><span class='k'>EXP</span><span class='v'>{hero.stats.exp.value}</span><span class='stat-bar exp'><i style={`--w:${expW}%`}></i></span></div>
          <div class='stat-meta'>
            <span>攻击 <b>长文×{essays}</b></span><span>防御 <b>笔记×{notes}</b></span><span>金币 <b>G{total}</b></span>
          </div>
        </div>
      </div>
    </Panel>

    <Panel title='占卜' en='DIVINATION' id='fortune' class='reveal'>
      <div class='fortune-body'>
        <div class='fortune-cup' id='fortuneCup' role='button' tabindex='0' aria-label='点击抽签' title='点击抽签'>
          <svg width='60' height='76' viewBox='0 0 32 40' shape-rendering='crispEdges' aria-hidden='true'>
            <rect x='8' y='2' width='2' height='8' fill='#f9f3e2'/><rect x='12' y='2' width='2' height='8' fill='#f9f3e2'/>
            <rect x='16' y='0' width='2' height='10' fill='#e9a13b'/>
            <rect x='6' y='10' width='20' height='4' fill='#d63a45'/>
            <rect x='4' y='14' width='24' height='16' fill='#d63a45'/>
            <rect x='2' y='16' width='2' height='12' fill='#b22a33'/>
            <rect x='28' y='16' width='2' height='12' fill='#b22a33'/>
            <rect x='4' y='30' width='24' height='4' fill='#b22a33'/>
            <rect x='8' y='14' width='2' height='16' fill='#b22a33'/><rect x='22' y='14' width='2' height='16' fill='#b22a33'/>
            <rect x='12' y='22' width='8' height='2' fill='#fff'/><rect x='12' y='26' width='8' height='2' fill='#fff'/>
          </svg>
        </div>
        <h3>占卜师的签筒 · 今日运势</h3>
        <p class='tip'>点击签筒或按 START 揭晓今日运势</p>
        <button class='fortune-btn' id='fortuneBtn'>摇签 ▶ START</button>
        <div class='fortune-result' id='fortuneResult' aria-live='polite'></div>
      </div>
    </Panel>
  </div>

  <Panel title='冒险记录' en='QUEST LOG' id='quests' class='reveal' link='/blog' linkLabel='全部冒险 →'>
    <ul class='quest-list'>
      {
        posts.map((post, i) => (
          <QuestItem {post} index={i} variant='home' />
        ))
      }
    </ul>
    {
      posts.length === 0 && (
        <p style='padding:14px 16px;color:var(--dim)'>暂无任务。</p>
      )
    }
  </Panel>

  <div class='grid-2'>
    <Panel title='道具袋' en='ITEMS' id='items' class='reveal'>
      <div class='item-grid'>
        {
          items.map((item) => (
            <div class='item-card'>
              <div class='item-icon'>{item.icon}</div>
              <div>
                <div class='it'>{item.rarity}</div>
                <h3>
                  {
                    item.repo.href.startsWith('http') ? (
                      <a href={item.repo.href} target='_blank' rel='noopener'>{item.title}</a>
                    ) : (
                      item.title
                    )
                  }
                </h3>
                <p>{item.desc}</p>
                <div class='btns'>
                  {
                    item.repo.href.startsWith('http') ? (
                      <a class='primary' href={item.repo.href} target='_blank' rel='noopener'>{item.repo.label}</a>
                    ) : (
                      <span class='primary'>{item.repo.label}</span>
                    )
                  }
                  {
                    item.demo.href.startsWith('http') ? (
                      <a href={item.demo.href} target='_blank' rel='noopener'>{item.demo.label}</a>
                    ) : (
                      <span>{item.demo.label}</span>
                    )
                  }
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Panel>

    <Panel title='队伍' en='PARTY' id='party' class='reveal' link='/about' linkLabel='勇者档案 →'>
      <div class='party-grid'>
        {
          party.map((member) => (
            <div class='party-card'>
              <div class='party-av'>
                {
                  member.avatar === 'warrior' ? (
                    <svg width='48' height='48' viewBox='0 0 24 24' shape-rendering='crispEdges' aria-hidden='true'>
                      <rect x='9' y='2' width='6' height='4' fill='#f0a030'/><rect x='8' y='6' width='8' height='6' fill='#ff2b35'/><rect x='10' y='12' width='4' height='2' fill='#f2f5ff'/><rect x='8' y='14' width='8' height='6' fill='#1d2c4d'/><rect x='6' y='20' width='4' height='2' fill='#0e1526'/><rect x='14' y='20' width='4' height='2' fill='#0e1526'/>
                    </svg>
                  ) : (
                    <svg width='48' height='48' viewBox='0 0 24 24' shape-rendering='crispEdges' aria-hidden='true'>
                      <rect x='9' y='2' width='6' height='4' fill='#33d5ff'/><rect x='8' y='6' width='8' height='6' fill='#1d2c4d'/><rect x='10' y='12' width='4' height='2' fill='#f2f5ff'/><rect x='8' y='14' width='8' height='6' fill='#33d5ff'/><rect x='6' y='20' width='4' height='2' fill='#0e1526'/><rect x='14' y='20' width='4' height='2' fill='#0e1526'/><rect x='18' y='8' width='2' height='6' fill='#f8d878'/>
                    </svg>
                  )
                }
              </div>
              <div>
                <h3>{member.title}</h3>
                <div class='cls'>{member.class}</div>
                <p>{member.desc}</p>
                <div class='period'>{member.period}</div>
              </div>
            </div>
          ))
        }
      </div>
    </Panel>
  </div>

  <Panel title='冒险档案' en='ACHIEVEMENTS' class='reveal'>
    <div class='achieve-rows'>
      <div class='achieve-row'>
        <div class='ar-title'>
          冒险记录 <span class='en'>ADVENTURES</span>
          <a class='px-link' href='/blog'>冒险记录 →</a>
        </div>
        <div class='ar-stats'>
          <div class='ar-stat'><b data-count={essays}>0</b> 长文</div>
          <div class='ar-stat'><b data-count={notes}>0</b> 笔记</div>
          <div class='ar-stat'><b data-count={essays + notes}>0</b> 文章</div>
        </div>
        {
          (exploreTags.length > 0 || noteTag) && (
            <div class='ar-tags'>
              <span>✍️ 探索地图：</span>
              {exploreTags.map((t) => <span class='tag'>{t.name} {t.n}</span>)}
              {noteTag && (
                <>
                  <span>·</span><span>📓 笔记：</span><span class='tag'>{noteTag[0]} {noteTag[1]}</span>
                </>
              )}
            </div>
          )
        }
      </div>
      <div class='achieve-row'>
        <div class='ar-title'>
          旅行日志 <span class='en'>JOURNEY</span>
          <a class='px-link' href='/logs'>旅行日志 →</a>
        </div>
        <div class='ar-stats'>
          <div class='ar-stat'><b data-count={logs}>0</b> 日志</div>
        </div>
      </div>
    </div>
  </Panel>

  <Dialogue
    speaker={site.heroName}
    avatar
    class='reveal'
    typewriter='欢迎来到我的冒险世界。我是全栈 Agent 开发工程师，正在用代码探索这片星海。用下面的命令菜单逛逛我的旅程吧。'
  />

  <div class='cmd-tip'>
    <span class='keys'>[ 方向键 ]</span> 选择命令 &nbsp;·&nbsp; <span class='keys'>[ A ]</span> 确定 &nbsp;·&nbsp; <span class='keys'>[ B ]</span> 取消
  </div>
</FamicomLayout>

<script>
  // —— PRESS START → 滚到状态区 ——
  const ps = document.getElementById('pressStart')
  if (ps) {
    ps.addEventListener('click', () => {
      const s = document.getElementById('status')
      if (s) {
        const y = s.getBoundingClientRect().top + window.scrollY - 24
        window.scrollTo({ top: y, behavior: 'smooth' })
      }
    })
  }

  // —— 打字机对话框（由 Dialogue.astro 全局处理）——

  // —— 冒险档案数字滚动 ——
  const ach = document.querySelector('.achieve-rows')
  if (ach && 'IntersectionObserver' in window) {
    const aio = new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return
          const box = e.target
          box.querySelectorAll('[data-count]').forEach((n) => {
            const el = n as HTMLElement
            const target = Number(el.dataset.count)
            const t0 = performance.now()
            function step(ts: number) {
              const p = Math.min((ts - t0) / 700, 1)
              el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))))
              if (p < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
          })
          aio.unobserve(box)
        })
      },
      { threshold: 0.4 }
    )
    aio.observe(ach)
  }

  // —— 点主角冒「咕嘟♪」气泡 ——
  document.querySelectorAll('[data-gu]').forEach((zone) => {
    zone.addEventListener('click', () => {
      zone.querySelectorAll('.gu-bubble').forEach((b) => b.parentNode?.removeChild(b))
      const b = document.createElement('span')
      b.className = 'gu-bubble'
      b.textContent = '咕嘟♪'
      zone.appendChild(b)
      setTimeout(() => b.parentNode?.removeChild(b), 900)
    })
  })

  // —— 占卜 ——
  const FORTUNES = [
    { t: '大吉', k: 'red', yi: '宜：合并 PR 一次通过', ji: '忌：周五下午部署代码', desc: '代码如行云流水，单测覆盖率直逼 100%，今天你是编译器的主宰！' },
    { t: '大吉', k: 'red', yi: '宜：一击定位遗留的远古 Bug', ji: '忌：参加没有议程的长会', desc: '直觉敏锐，内存泄漏一点即中，连主架构师都对你刮目相看。' },
    { t: '中吉', k: 'cyan', yi: '宜：重构一段烂代码', ji: '忌：依赖未文档化的第三方库', desc: '今天写出的每一行都是艺术品，Code Review 直接通过。' },
    { t: '中吉', k: 'cyan', yi: '宜：抽空给开源项目提 Issue', ji: '忌：无视编译器警告', desc: '作者秒回，你不仅解了题还交了个极客朋友。' },
    { t: '小吉', k: 'gold', yi: '宜：清理过期的本地分支', ji: '忌：加糖奶茶超大杯', desc: '无大富，但也没有 Core Dump，平安即福，早点睡觉。' },
    { t: '小吉', k: 'gold', yi: '宜：为开源贡献第一行代码', ji: '忌：留下 // TODO: fix later', desc: '小步也是通往大黑客的巨跃，适合启动那个副业项目。' },
    { t: '末吉', k: 'dim', yi: '宜：保存进度，早点下班', ji: '忌：通宵硬刚需求', desc: '运势平平，稳住别浪，把存档保存好，明天再战。' }
  ]

  const btn = document.getElementById('fortuneBtn') as HTMLButtonElement
  const cup = document.getElementById('fortuneCup')
  const res = document.getElementById('fortuneResult') as HTMLElement
  let t: ReturnType<typeof setTimeout> | null = null

  function burst(el: HTMLElement) {
    const c = document.createElement('span')
    c.className = 'burst'
    for (let i = 0; i < 8; i++) {
      const s = document.createElement('i')
      s.style.setProperty('--dx', (Math.random() * 90 - 45).toFixed(0) + 'px')
      s.style.setProperty('--dy', (Math.random() * 70 - 55).toFixed(0) + 'px')
      s.style.setProperty('--rot', (Math.random() * 360).toFixed(0) + 'deg')
      c.appendChild(s)
    }
    el.appendChild(c)
    setTimeout(() => c.parentNode?.removeChild(c), 900)
  }

  function draw() {
    const f = FORTUNES[Math.floor(Math.random() * FORTUNES.length)]
    res.className = 'fortune-result show'
    res.innerHTML =
      `<div class="type ${f.k}">${f.t}</div>` +
      `<div class="yi">${f.yi}</div>` +
      `<div class="ji">${f.ji}</div>` +
      `<div class="desc">${f.desc}</div>` +
      '<button class="again">再抽一次 ↻</button>'
    if (f.k === 'red') burst(res)
    res.querySelector('.again')?.addEventListener('click', go)
  }

  function go() {
    if (btn.disabled) return
    btn.disabled = true
    btn.textContent = '求签中…'
    cup?.classList.add('shake')
    res.classList.remove('show')
    if (t) clearTimeout(t)
    t = setTimeout(() => {
      cup?.classList.remove('shake')
      btn.disabled = false
      btn.textContent = '摇签 ▶ START'
      draw()
    }, 900)
  }

  btn.addEventListener('click', go)
  cup?.addEventListener('click', go)
  cup?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      go()
    }
  })
</script>
