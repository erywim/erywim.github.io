---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import Panel from '@/components/famicom/Panel.astro'
import { friends } from '@/data/friends'
---

<FamicomLayout title='伙伴酒馆'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '伙伴酒馆' }]} />

  <CmdMenu active='links' />

  <Panel title='伙伴名单' en={`ALLIES · ${friends.length}`} class='reveal'>
    <div class='intro'>
      「这是我的<b>伙伴们</b>，排名不分先后。」—— 酒馆老板娘说，他们在这片大陆上各有各的冒险。
    </div>
    {
      friends.length > 0 ? (
        <div class='guild-grid'>
          {
            friends.map((friend) => (
              <div class='party-card'>
                <div class='party-av'>{friend.avatar}</div>
                <div>
                  <h3>
                    {
                      friend.link !== '#' ? (
                        <a href={friend.link} target='_blank' rel='noopener'>{friend.name}</a>
                      ) : (
                        friend.name
                      )
                    }
                  </h3>
                  <div class='cls'>{friend.role}</div>
                  <p>{friend.intro}</p>
                  {
                    friend.link !== '#' ? (
                      <a class='go' href={friend.link} target='_blank' rel='noopener'>访问领地 →</a>
                    ) : (
                      <span class='go'>访问领地 →</span>
                    )
                  }
                </div>
              </div>
            ))
          }
        </div>
      ) : (
        <p style='padding:16px;color:var(--dim)'>伙伴名单整理中，敬请期待。</p>
      )
    }
  </Panel>

  <Dialogue speaker='酒馆老板娘' avatar sprite='miku' class='reveal' typewriter='要交换酒馆情报吗？在你的网站上挂上我的信息，再发封邮件或到 GitHub 提交 Issue，我就把新伙伴的名册给你。' />
</FamicomLayout>
