---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import FishSprite from '@/components/famicom/FishSprite.astro'
import Panel from '@/components/famicom/Panel.astro'
import { hero } from '@/data/hero'
import { site } from '@/data/site'

const hpW = hero.stats.hp.max ? Math.round((hero.stats.hp.value / hero.stats.hp.max) * 100) : 0
const mpW = hero.stats.mp.max ? Math.round((hero.stats.mp.value / hero.stats.mp.max) * 100) : 0
const expW = hero.stats.exp.max ? Math.round((hero.stats.exp.value / hero.stats.exp.max) * 100) : 0
---

<FamicomLayout title='勇者档案'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '勇者档案' }]} />

  <CmdMenu active='about' />

  <Panel title='主人公' en='PLAYER CHARACTER' class='reveal'>
    <div class='hero-card'>
      <div class='hero-av'>
        <span class='fish'>
          <FishSprite width={120} height={64} label='勇者头像' />
        </span>
      </div>
      <div>
        <div class='hero-name'>{site.heroName}</div>
        <div class='hero-class'>{hero.class}</div>
        <div class='stat-row'><span class='k'>HP</span><span class='v'>{hero.stats.hp.value}</span><span class='stat-bar hp'><i style={`--w:${hpW}%`}></i></span></div>
        <div class='stat-row'><span class='k'>MP</span><span class='v'>{hero.stats.mp.value}</span><span class='stat-bar mp'><i style={`--w:${mpW}%`}></i></span></div>
        <div class='stat-row'><span class='k'>EXP</span><span class='v'>{hero.stats.exp.value}</span><span class='stat-bar exp'><i style={`--w:${expW}%`}></i></span></div>
        <div class='hero-bio'>{hero.bio}</div>
        <div class='hero-tags'>
          <span class='tag-chip loc'>
            <span class='tag-label'>
              <svg class='px-pin' viewBox='0 0 6 7' width='12' height='14' shape-rendering='crispEdges' aria-hidden='true'>
                <rect x='2' y='0' width='2' height='1'/>
                <rect x='1' y='1' width='4' height='1'/>
                <rect x='0' y='2' width='2' height='1'/>
                <rect x='4' y='2' width='2' height='1'/>
                <rect x='0' y='3' width='1' height='1'/>
                <rect x='5' y='3' width='1' height='1'/>
                <rect x='0' y='4' width='2' height='1'/>
                <rect x='4' y='4' width='2' height='1'/>
                <rect x='1' y='5' width='4' height='1'/>
                <rect x='2' y='6' width='2' height='1'/>
              </svg>
              坐标
            </span>
            <b>{hero.location}</b>
          </span>
          <span class='tag-chip st'>
            <span class='tag-label'><i class='led' aria-hidden='true'></i>状态</span>
            <b>{hero.status}</b>
          </span>
        </div>
      </div>
    </div>
  </Panel>

  <Panel title='习得技能' en='SKILLS & SPELLS' class='reveal'>
    <div class='skill-grid'>
      {
        hero.skills.map((skill) => (
          <div class='skill-card'>
            <h3>{skill.title}</h3>
            <div class='chips'>
              {skill.chips.map((chip) => <span>{chip}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </Panel>

  <Panel title='冒险历程' en='ADVENTURE HISTORY' class='reveal'>
    <ul class='timeline'>
      {
        hero.timeline.map((item) => (
          <li class='tl-item'>
            <span class='tl-rail' aria-hidden='true'>
              <i class='tl-node'></i>
            </span>
            <div class='tl-body'>
              <span class='tl-date'>{item.date}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Panel>

  <Panel title='联系方式' en='CONTACT' class='reveal'>
    <div class='contact-body'>
      {
        hero.contacts.map((c) => (
          <a class='contact-item' href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel='noopener'>
            <span class='ci-ic'>
              <svg width='20' height='20' viewBox='0 0 10 10' shape-rendering='crispEdges' aria-hidden='true'><use href={`#pix-contact-${c.icon}`}/></svg>
            </span>
            <span class='ci-label'>{c.label}</span>
            <span class='ci-value'>{c.value}</span>
            <span class='ci-arrow'>→</span>
          </a>
        ))
      }
    </div>
  </Panel>

  <Dialogue speaker={site.heroName} avatar class='reveal' typewriter='这就是我的能力面板。想看看我用这些技能打过的仗吗？去冒险记录里挑一卷吧。' />
</FamicomLayout>
