---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import FishSprite from '@/components/famicom/FishSprite.astro'
import Panel from '@/components/famicom/Panel.astro'
import { hero } from '@/data/hero'
import { site } from '@/data/site'

const hpW = hero.stats.hp.max ? Math.round((hero.stats.hp.value / hero.stats.hp.max) * 100) : 0
const mpW = hero.stats.mp.max ? Math.round((hero.stats.mp.value / hero.stats.mp.max) * 100) : 0
const expW = hero.stats.exp.max ? Math.round((hero.stats.exp.value / hero.stats.exp.max) * 100) : 0
---

<FamicomLayout title='勇者档案'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '勇者档案' }]} />

  <div class='page-head'>
    <h1>勇者<b>档案</b></h1>
    <span class='en'>HERO PROFILE</span>
  </div>

  <CmdMenu active='about' />

  <Panel title='主人公' en='PLAYER CHARACTER' class='reveal'>
    <div class='hero-card'>
      <div class='hero-av'>
        <FishSprite width={120} height={64} label='勇者头像' />
      </div>
      <div>
        <div class='hero-name'>{site.heroName}</div>
        <div class='hero-class'>{hero.class}</div>
        <div class='stat-row'><span class='k'>HP</span><span class='v'>{hero.stats.hp.value}</span><span class='stat-bar hp'><i style={`--w:${hpW}%`}></i></span></div>
        <div class='stat-row'><span class='k'>MP</span><span class='v'>{hero.stats.mp.value}</span><span class='stat-bar mp'><i style={`--w:${mpW}%`}></i></span></div>
        <div class='stat-row'><span class='k'>EXP</span><span class='v'>{hero.stats.exp.value}</span><span class='stat-bar exp'><i style={`--w:${expW}%`}></i></span></div>
        <div class='hero-bio'>
          {hero.bio}<br />
          <b>坐标</b> {hero.location} · <b>状态</b> {hero.status}
        </div>
      </div>
    </div>
  </Panel>

  <Panel title='习得技能' en='SKILLS & SPELLS' class='reveal'>
    <div class='skill-grid'>
      {
        hero.skills.map((skill) => (
          <div class='skill-card'>
            <h3>{skill.title}</h3>
            <div class='chips'>
              {skill.chips.map((chip) => <span>{chip}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </Panel>

  <Panel title='冒险历程' en='ADVENTURE HISTORY' class='reveal'>
    <ul class='timeline'>
      {
        hero.timeline.map((item) => (
          <li class='tl-item'>
            <span class='tl-date'>{item.date}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Panel>

  <Dialogue speaker={site.heroName} avatar class='reveal'>
    这就是我的能力面板。想看看我用这些技能打过的仗吗？去冒险记录里挑一卷吧。
  </Dialogue>
</FamicomLayout>
