---
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import { site } from '@/data/site'
---

<FamicomLayout title='404'>

  <div class='scroll reveal' style='text-align:center;padding:40px 24px'>
    <h2>▍此处空无一物</h2>
    <p>你似乎走到了一片没有怪物也没有宝箱的区域……</p>
    <p style='margin-top:20px'>
      <a class='quest-go' href='/' style='display:inline-flex'>■ 返回标题画面</a>
    </p>
  </div>

  <Dialogue speaker={site.heroName}>
    地图上还没有这个坐标。回标题画面选个新去处吧。
  </Dialogue>
</FamicomLayout>
