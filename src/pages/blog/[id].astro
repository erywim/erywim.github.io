---
import { render, type CollectionEntry } from 'astro:content'

import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import { site } from '@/data/site'
import { getBlogByRank, getPublishedBlog } from '@/utils/collections'
import { formatQuestDate } from '@/utils/format'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getPublishedBlog()
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

type Props = {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const byRank = await getBlogByRank()
const byDate = await getPublishedBlog()
const rankIndex = byRank.findIndex((p) => p.id === post.id)
const dateIndex = byDate.findIndex((p) => p.id === post.id)
const prev = byDate[dateIndex - 1] // 更新的任务
const next = byDate[dateIndex + 1] // 更旧的任务

const rank = post.data.rank ?? 'B'
const REWARD: Record<string, { exp: number; g: number; ach: string }> = {
  S: { exp: 500, g: 88, ach: '传说级冒险家' },
  A: { exp: 300, g: 66, ach: '精英冒险家' },
  B: { exp: 200, g: 44, ach: '熟练冒险家' },
  C: { exp: 100, g: 22, ach: '初出茅庐' }
}
const reward = REWARD[rank] ?? REWARD.B
const qno = String(rankIndex + 1).padStart(2, '0')

// 目录：展平 headings 树，取 h2 / h3
interface TocItem {
  depth: number
  slug: string
  text: string
}
const tocItems: TocItem[] = []
function walk(hs: { depth: number; slug: string; text: string; children: unknown[] }[]) {
  for (const h of hs) {
    if (h.depth >= 2 && h.depth <= 3) tocItems.push({ depth: h.depth, slug: h.slug, text: h.text })
    if (h.children) walk(h.children as typeof hs)
  }
}
walk(headings as { depth: number; slug: string; text: string; children: unknown[] }[])

---

<FamicomLayout title={post.data.title} description={post.data.description}>
  <a class='back-btn' href='/blog' aria-label='返回冒险记录'>← 返回</a>

  <div class='detail-grid'>
    <div class='detail-main'>
      <header class='quest-head reveal'>
        <div class='qno'>
          QUEST <b>{qno}</b> · <span style='color:var(--gold)'>RANK {rank}</span>
        </div>
        <h1>{post.data.title}</h1>
        <div class='qmeta'>
          <span>地图 <b>{post.data.category}</b></span>
          <span>日期 <b>{formatQuestDate(post.data.publishDate)}</b></span>
          <span>状态 <b style='color:var(--green)'>已达成</b></span>
        </div>
        {
          post.data.tags.length > 0 && (
            <div class='quest-tags'>
              {post.data.tags.map((tag) => <span class='tag'>{tag}</span>)}
            </div>
          )
        }
        <div class='reward'>
          任务奖励：<b>EXP +{reward.exp}</b> · <b>G +{reward.g}</b> · 解锁成就「{reward.ach}」
        </div>
      </header>

      <article class='scroll reveal'>
        <Content />
      </article>

      <div class='nav-quests'>
        {
          prev && (
            <a href={`/blog/${prev.id}`}>
              <span class='dir'>◀ 上一任务</span>{prev.data.title}
            </a>
          )
        }
        {
          next && (
            <a href={`/blog/${next.id}`} style='text-align:right'>
              <span class='dir'>下一任务 ▶</span>{next.data.title}
            </a>
          )
        }
      </div>

      <Dialogue speaker={site.heroName} avatar class='reveal' typewriter={`${post.data.title} —— 任务卷轴已归档。回到冒险记录可以查看其他战役。`} />
    </div>

    {
      tocItems.length > 0 && (
        <aside class='toc reveal'>
          <div class='toc-title'>本卷目录 <span style='font-size:8px;color:var(--dim)'>TOC</span></div>
          <ul class='toc-list'>
            {
              tocItems.map((item) => (
                <li class={item.depth === 3 ? 'toc-l3' : undefined}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))
            }
          </ul>
        </aside>
      )
    }
  </div>
</FamicomLayout>

<script>
  // —— 目录滚动高亮 ——
  const tocLinks = Array.from(document.querySelectorAll('.toc-list a'))
  if (tocLinks.length > 0) {
    const ids = tocLinks
      .map((a) => a.getAttribute('href')?.slice(1))
      .filter((id): id is string => Boolean(id))
    const map = new Map<string, HTMLElement | null>()
    ids.forEach((id) => map.set(id, document.getElementById(id)))
    const current = () => {
      const pos = window.scrollY + 110
      let activeId = ids[0]
      for (const id of ids) {
        const el = map.get(id)
        if (el && el.offsetTop <= pos) activeId = id
      }
      tocLinks.forEach((a) => {
        a.classList.toggle('active', a.getAttribute('href') === `#${activeId}`)
      })
    }
    window.addEventListener('scroll', current, { passive: true })
    current()
  }
</script>
