---
import Breadcrumb from '@/components/famicom/Breadcrumb.astro'
import CmdMenu from '@/components/famicom/CmdMenu.astro'
import Dialogue from '@/components/famicom/Dialogue.astro'
import FamicomLayout from '@/components/famicom/FamicomLayout.astro'
import Panel from '@/components/famicom/Panel.astro'
import QuestItem from '@/components/famicom/QuestItem.astro'
import { site } from '@/data/site'
import { getPublishedBlog } from '@/utils/collections'

const posts = await getPublishedBlog()
---

<FamicomLayout title='冒险记录'>
  <Breadcrumb items={[{ label: '■ 标题画面', href: '/' }, { label: '冒险记录' }]} />

  <CmdMenu active='blog' />

  <Panel title='已接任务' en={`CURRENT QUESTS · ${posts.length}`} class='reveal'>
    <ul class='quest-list'>
      {
        posts.map((post, i) => (
          <QuestItem {post} index={i} variant='log' />
        ))
      }
    </ul>
    {
      posts.length === 0 && (
        <p style='padding:14px 16px;color:var(--dim)'>暂无任务。</p>
      )
    }
  </Panel>

  <Dialogue speaker={site.heroName} avatar class='reveal' typewriter='这些是我完成过的冒险。点开任务卷轴，可以查看当时的战斗记录与思考。\n> 以前的文笔比较烂(例如ThreadLocal篇，虽然现在也没多好)，就不把以前写的博客搬上来了' />
</FamicomLayout>
