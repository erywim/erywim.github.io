---
interface Props {
  /** 当前高亮的命令项；首页/搜索页传空则不高亮 */
  active?: 'about' | 'blog' | 'logs' | 'links' | 'search' | 'treasure'
}

const { active } = Astro.props

// 所有页面（含首页）点击均跳转到对应子页面
const items = [
  { key: 'about', ic: '♛', label: '勇者档案', href: '/about' },
  { key: 'blog', ic: '◆', label: '冒险记录', href: '/blog' },
  { key: 'logs', ic: '✎', label: '旅行日志', href: '/logs' },
  { key: 'treasure', ic: '▣', label: '道具宝箱', href: '/treasure' },
  { key: 'links', ic: '♞', label: '伙伴酒馆', href: '/links' }
]
---

<nav class='cmd-menu'>
  {
    items.map((item) => (
      <a
        href={item.href}
        class={active === item.key ? 'active' : undefined}
      >
        <span class='ic'>{item.ic}</span>{item.label}
      </a>
    ))
  }
</nav>
