---
interface Props {
  /** 当前高亮的命令项；首页/搜索页传空则不高亮 */
  active?: 'about' | 'blog' | 'logs' | 'links' | 'search'
}

const { active } = Astro.props

// scroll = 首页对应模块的锚点 id；无 scroll 的项（如旅行日志）在首页直接跳转 href
const items = [
  { key: 'about', ic: '♛', label: '勇者档案', href: '/about', scroll: 'status' },
  { key: 'blog', ic: '◆', label: '冒险记录', href: '/blog', scroll: 'quests' },
  { key: 'logs', ic: '✎', label: '旅行日志', href: '/logs' },
  { key: 'links', ic: '♞', label: '伙伴酒馆', href: '/links' }
]
---

<nav class='cmd-menu'>
  {
    items.map((item) => (
      <a
        href={item.href}
        data-scroll={item.scroll ?? undefined}
        class={active === item.key ? 'active' : undefined}
      >
        <span class='ic'>{item.ic}</span>{item.label}
      </a>
    ))
  }
</nav>

<script>
  // 首页：平滑滚动到对应模块；子页面：跳转到对应子页面
  const menu = document.querySelector('.cmd-menu')
  if (menu) {
    menu.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a')
      if (!link) return
      const scrollId = link.dataset.scroll
      const onHome = location.pathname === '/' || location.pathname === '/index.html'
      if (onHome && scrollId) {
        e.preventDefault()
        const el = document.getElementById(scrollId)
        if (el) el.scrollIntoView({ behavior: 'smooth' })
        else location.href = link.href
      }
    })
  }
</script>
