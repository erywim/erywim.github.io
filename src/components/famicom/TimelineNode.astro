---
/**
 * 时间线像素节点 —— 按 icon 渲染对应时代的小像素画（SVG rect，crispEdges）
 * edu=学士帽 / telecom=信号塔 / ai=机器人头
 * 配色由 famicom.css 中 .tl-node 的 CSS 变量控制，随昼夜主题自适应。
 */
interface Props {
  icon?: 'edu' | 'telecom' | 'ai'
}
const { icon } = Astro.props
---

{icon === 'edu' && (
  <svg
    class='tl-node'
    viewBox='0 0 16 14'
    width='56'
    height='49'
    shape-rendering='crispEdges'
    aria-hidden='true'
  >
    <!-- 学士帽板（菱形） -->
    <rect x='6' y='0' width='4' height='1' class='g'/>
    <rect x='5' y='1' width='6' height='1' class='g'/>
    <rect x='4' y='2' width='8' height='1' class='g'/>
    <rect x='3' y='3' width='10' height='1' class='g'/>
    <rect x='2' y='4' width='12' height='1' class='g'/>
    <rect x='1' y='5' width='14' height='1' class='g'/>
    <rect x='0' y='6' width='16' height='1' class='g'/>
    <rect x='1' y='7' width='14' height='1' class='g2'/>
    <rect x='3' y='8' width='10' height='1' class='g2'/>
    <!-- 帽身 -->
    <rect x='4' y='9' width='8' height='1'/>
    <rect x='5' y='10' width='6' height='1'/>
    <rect x='6' y='11' width='4' height='1'/>
    <!-- 高光 -->
    <rect x='5' y='1' width='2' height='1' class='h'/>
    <rect x='4' y='2' width='2' height='1' class='h'/>
    <!-- 流苏 -->
    <rect x='15' y='6' width='1' height='5' class='g2'/>
    <rect x='13' y='10' width='3' height='2' class='g2'/>
  </svg>
)}

{icon === 'telecom' && (
  <svg
    class='tl-node'
    viewBox='0 0 16 16'
    width='56'
    height='56'
    shape-rendering='crispEdges'
    aria-hidden='true'
  >
    <!-- 塔顶信标 -->
    <rect x='7' y='0' width='1' height='1' class='r'/>
    <rect x='6' y='1' width='3' height='1' class='r'/>
    <!-- 塔身 -->
    <rect x='7' y='2' width='1' height='1'/>
    <rect x='7' y='4' width='1' height='1'/>
    <rect x='7' y='6' width='1' height='1'/>
    <rect x='7' y='8' width='1' height='1'/>
    <rect x='7' y='10' width='1' height='1'/>
    <!-- 横撑 -->
    <rect x='5' y='3' width='5' height='1'/>
    <rect x='4' y='5' width='7' height='1'/>
    <rect x='3' y='7' width='9' height='1'/>
    <rect x='2' y='9' width='11' height='1'/>
    <!-- 塔基 -->
    <rect x='6' y='11' width='3' height='1'/>
    <rect x='5' y='12' width='5' height='1'/>
    <rect x='4' y='13' width='7' height='1'/>
    <rect x='3' y='14' width='9' height='1'/>
    <!-- 地面 -->
    <rect x='2' y='15' width='11' height='1' class='g2'/>
    <!-- 信号波 -->
    <rect x='9' y='0' width='2' height='1' class='gr'/>
    <rect x='10' y='1' width='3' height='1' class='gr'/>
    <rect x='11' y='2' width='3' height='1' class='gr'/>
    <rect x='11' y='3' width='2' height='1' class='gr'/>
    <rect x='12' y='5' width='2' height='1' class='gr'/>
    <rect x='13' y='6' width='3' height='1' class='gr'/>
    <rect x='13' y='7' width='2' height='1' class='gr'/>
  </svg>
)}

{icon === 'ai' && (
  <svg
    class='tl-node'
    viewBox='0 0 16 12'
    width='56'
    height='42'
    shape-rendering='crispEdges'
    aria-hidden='true'
  >
    <!-- 天线 -->
    <rect x='6' y='0' width='4' height='1' class='c'/>
    <rect x='7' y='1' width='2' height='1'/>
    <!-- 头部轮廓 -->
    <rect x='5' y='2' width='6' height='1'/>
    <rect x='3' y='3' width='10' height='1'/>
    <!-- 头部 -->
    <rect x='3' y='4' width='10' height='2' class='c'/>
    <!-- 面部 -->
    <rect x='4' y='6' width='8' height='4' class='c'/>
    <!-- 侧耳 -->
    <rect x='2' y='4' width='1' height='3'/>
    <rect x='13' y='4' width='1' height='3'/>
    <!-- 高光 -->
    <rect x='4' y='4' width='2' height='1' class='h'/>
    <!-- 眼睛 -->
    <rect x='6' y='8' width='1' height='1' class='r'/>
    <rect x='9' y='8' width='1' height='1' class='r'/>
    <!-- 嘴 -->
    <rect x='7' y='9' width='2' height='1'/>
    <!-- 下颚轮廓 -->
    <rect x='4' y='10' width='8' height='1'/>
    <!-- 脖子 -->
    <rect x='6' y='11' width='4' height='1'/>
  </svg>
)}
