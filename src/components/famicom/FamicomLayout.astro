      <rect x="3" y="4" width="2" height="1" fill="var(--dove)"/>
    </symbol>
    <symbol id="pixel-bubble" viewBox="0 0 10 12">
      <rect x="4" y="0" width="2" height="1" fill="var(--bubble-hi)"/>
      <rect x="2" y="1" width="6" height="1" fill="var(--bubble)"/>
