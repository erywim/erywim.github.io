      <svg class='dove' style='top:34%;left:22%;width:20px'><use href='#pixel-dove'/></svg>
      <svg class='dove' style='top:60%;right:14%;width:24px'><use href='#pixel-dove'/></svg>
      <svg class='ffish' style='top:20%;width:34px;opacity:.6'><use href='#pixel-fish'/></svg>
      <svg class='ffish' style='top:48%;width:26px;opacity:.45'><use href='#pixel-fish'/></svg>
      <!-- 深海世界：泡泡 + 水草（仅夜间） -->
