    </symbol>
    <symbol id="pixel-isle" viewBox="0 0 26 18">
      <rect x="8" y="1" width="10" height="1" fill="var(--isle-roof)"/>
      <rect x="9" y="2" width="8" height="1" fill="var(--isle-bldg)"/>
      <rect x="10" y="3" width="6" height="4" fill="var(--isle-bldg)"/>
      <rect x="12" y="4" width="2" height="2" fill="var(--isle-win)"/>
      <rect x="11" y="7" width="4" height="1" fill="var(--isle-roof)"/>
      <rect x="4" y="8" width="18" height="1" fill="var(--isle-grass)"/>
      <rect x="2" y="9" width="22" height="1" fill="var(--isle-grass2)"/>
      <rect x="0" y="10" width="26" height="1" fill="var(--isle-rock)"/>
      <rect x="1" y="11" width="24" height="1" fill="var(--isle-rock)"/>
      <rect x="3" y="12" width="20" height="1" fill="var(--isle-rock)"/>
      <rect x="5" y="13" width="16" height="1" fill="var(--isle-rock)"/>
