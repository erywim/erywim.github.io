    <script is:inline>
      // RPG 掉落：首绘前把显示位归 0，为滚动动画做起点（无 JS / 无数据时保留服务端兜底值）
      try {
        const _n = document.getElementById('rpg-quest-data')
        if (_n && _n.textContent) {
          document.querySelectorAll('[data-stat]').forEach((el) => {
            el.textContent =
              el.dataset.stat === 'gold'
                ? el.hasAttribute('data-lite')
                  ? 'G0'
                  : 'G 0000'
                : el.dataset.stat === 'level'
                  ? 'LV.1'
                  : '0'
          })
        }
      } catch (e) {}
    </script>
