---
import config from '@/site-config'
import { site } from '@/data/site'
import { sayings } from '@/data/sayings'
import { TITLES } from '@/data/titles'
import { getPublishedBlog } from '@/utils/collections'
import { getRpgStats } from '@/utils/rpg'
import '@/assets/styles/famicom.css'

interface Props {
  title?: string
  description?: string
}

const { title, description = config.description } = Astro.props
const pageTitle =
  title && title !== config.title ? `${title} · ${site.gameTitle}` : site.gameTitle

// RPG 掉落合计（构建期兜底值，客户端异步统计后再滚动回显）
const { gold, level, quests } = getRpgStats(await getPublishedBlog())
const goldStr = `G ${String(gold).padStart(4, '0')}`
const levelStr = `LV.${level}`

const favicon =
  'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22%3E%3Crect width=%2216%22 height=%2216%22 fill=%22%237cc4f2%22/%3E%3Crect x=%223%22 y=%223%22 width=%2210%22 height=%2210%22 fill=%22%23d63a45%22/%3E%3Crect x=%225%22 y=%225%22 width=%226%22 height=%226%22 fill=%22%23fff8ec%22/%3E%3C/svg%3E'
---

<!doctype html>
<html lang={config.locale.lang} data-theme='day'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{pageTitle}</title>
    <meta name='description' content={description} />
    <link rel='icon' href={favicon} />
    <link rel='canonical' href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name='color-scheme' content='light' />
    <meta name='theme-color' content='#7cc4f2' />
    <meta name='generator' content={Astro.generator} />
    <link rel='preload' href='/fonts/fusion-pixel-12px.woff2' as='font' type='font/woff2' crossorigin='anonymous' />
    <link rel='preload' href='/fonts/press-start-2p.woff2' as='font' type='font/woff2' crossorigin='anonymous' />
    <script is:inline>
      ;(function () {
        try {
          if (localStorage.getItem('cq-theme') === 'night') {
            document.documentElement.setAttribute('data-theme', 'night')
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <div id='progress' aria-hidden='true'></div>
    <a id='toTop' href='#' aria-label='回到顶部'>▲ TOP</a>

    <!-- 天穹背景：天空之城（昼） ↔ 深海世界（夜） -->
