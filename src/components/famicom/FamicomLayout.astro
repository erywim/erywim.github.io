      <rect x="0" y="10" width="26" height="1" fill="var(--isle-rock)"/>
      <rect x="1" y="11" width="24" height="1" fill="var(--isle-rock)"/>
      <rect x="3" y="12" width="20" height="1" fill="var(--isle-rock)"/>
      <rect x="5" y="13" width="16" height="1" fill="var(--isle-rock)"/>
      <rect x="8" y="14" width="10" height="1" fill="var(--isle-rock2)"/>
      <rect x="6" y="13" width="2" height="2" fill="var(--isle-rock2)"/>
      <rect x="18" y="13" width="2" height="2" fill="var(--isle-rock2)"/>
    </symbol>
    <symbol id="pixel-dove" viewBox="0 0 8 5">
      <rect x="3" y="0" width="2" height="1" fill="var(--dove)"/>
      <rect x="2" y="1" width="4" height="1" fill="var(--dove)"/>
      <rect x="0" y="2" width="8" height="1" fill="var(--dove)"/>
