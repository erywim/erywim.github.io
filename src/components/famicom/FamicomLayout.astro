        <svg class='bubble' style='left:6%;bottom:6%;width:16px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:14%;bottom:26%;width:12px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:26%;bottom:14%;width:18px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:38%;bottom:36%;width:10px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:50%;bottom:8%;width:20px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:62%;bottom:30%;width:13px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:74%;bottom:10%;width:16px'><use href='#pixel-bubble'/></svg>
        <svg class='bubble' style='left:84%;bottom:32%;width:11px'><use href='#pixel-bubble'/></svg>
        <svg class='kelp' style='left:1%;bottom:0;width:52px;opacity:.85'><use href='#pixel-kelp'/></svg>
        <svg class='kelp' style='right:2%;bottom:0;width:64px;opacity:.9'><use href='#pixel-kelp'/></svg>
        <svg class='kelp' style='right:14%;bottom:-4%;width:40px;opacity:.6'><use href='#pixel-kelp'/></svg>
      </div>
      <div class='floaters' id='floaters' aria-hidden='true'></div>
    </div>
    <div id='divefx' aria-hidden='true'></div>
    <script is:inline>
      // 所有背景动画元素（云/鸽/飞鱼/岛/星尘/气泡/水草/图层）统一按「墙钟时间 + 各自相位」
      // 设负 animation-delay：切页（整页重载）后从对应进度继续，而不是每次都回到动画起点
      // （横向漂移类会集体退到最左、上升类会集体退到最底）。读计算样式拿时长与方向，天空/深海一致。
      ;(function () {
        var epoch = Date.now() / 1000
        document.querySelectorAll(
          '#skyfx .layer, #skyfx .cl, #skyfx .spark, #skyfx .isle, #skyfx .dove, #skyfx .ffish, #skyfx .bubble, #skyfx .kelp'
        ).forEach(function (el, i) {
          var cs = getComputedStyle(el)
          var dur = parseFloat(cs.animationDuration) || 10
          var dir = cs.animationDirection
          var cycle = dir === 'alternate' || dir === 'alternate-reverse' ? dur * 2 : dur
          var phase = (i * 17 + 7) % cycle
          el.style.animationDelay = (-((phase + epoch) % cycle)).toFixed(2) + 's'
        })
      })()
    </script>
    <script is:inline>
      // 漂浮物提前到「首绘前」生成：从 sessionStorage 恢复上一次的漂浮物（按墙钟时间 startAt 续播），
      // 不足 3 个再随机补。这样重页（如勇者档案）即使加载慢，漂浮物也不会“迟到”被误判为重置。
      ;(function () {
        var root = document.documentElement
        var fbox = document.getElementById('floaters')
        if (!fbox) return
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var LIB = {
          sky: [
            { id: 'pixel-plane', w: 16, h: 10 }, { id: 'pixel-balloon', w: 12, h: 16 }, { id: 'pixel-kite', w: 14, h: 14 },
            { id: 'pixel-lantern', w: 10, h: 13 }, { id: 'pixel-soap', w: 10, h: 10 }, { id: 'pixel-leaf', w: 14, h: 10 },
            { id: 'pixel-feather', w: 10, h: 16 }, { id: 'pixel-wisp', w: 14, h: 8 }, { id: 'pixel-blimp', w: 18, h: 8 },
            { id: 'pixel-crane', w: 14, h: 10 }
          ],
          sea: [
            { id: 'pixel-jelly', w: 12, h: 16 }, { id: 'pixel-fish2', w: 14, h: 9 }, { id: 'pixel-seahorse', w: 10, h: 16 },
            { id: 'pixel-turtle', w: 14, h: 10 }, { id: 'pixel-starfish', w: 12, h: 12 }, { id: 'pixel-conch', w: 12, h: 12 },
            { id: 'pixel-pearl', w: 10, h: 10 }, { id: 'pixel-bubble2', w: 16, h: 12 }, { id: 'pixel-octopus', w: 14, h: 14 },
            { id: 'pixel-coral', w: 12, h: 14 }
          ]
        }
        var pool = []
        var FLOAT_KEY = 'erywim-floaters'
        var world = function () { return root.getAttribute('data-theme') === 'night' ? 'sea' : 'sky' }
        var activeIds = function () { return pool.map(function (p) { return p.dataset.id }) }
        function shuffle(a) {
          for (var i = a.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1))
            var t = a[i]; a[i] = a[j]; a[j] = t
          }
          return a
        }
        function saveState() {
          try {
            var list = pool.map(function (el) {
              return {
                id: el.dataset.id || '',
                dir: el.classList.contains('rtl') ? 'rtl' : 'ltr',
                top: parseFloat(el.style.top),
                dur: parseFloat(el.style.getPropertyValue('--dur')) || 36,
                size: parseFloat(el.dataset.size || '24'),
                startAt: Number(el.dataset.startAt) || Date.now()
              }
            })
            sessionStorage.setItem(FLOAT_KEY, JSON.stringify(list))
          } catch (e) {}
        }
        function onFloaterEnd(el) {
          return function () {
            if (el.parentNode) el.parentNode.removeChild(el)
            var i = pool.indexOf(el)
            if (i >= 0) pool.splice(i, 1)
            saveState()
          }
        }
        function build(it, dir, top, dur, size, delay, startAt) {
          var el = document.createElement('div')
          el.className = 'floater ' + dir
          el.dataset.id = it.id
          el.dataset.size = String(size)
          el.dataset.startAt = String(startAt)
          el.style.top = top.toFixed(1) + '%'
          el.style.setProperty('--dur', dur.toFixed(1) + 's')
          el.style.setProperty('--delay', delay.toFixed(1) + 's')
          var h = Math.round((size * it.h) / it.w)
          el.innerHTML = '<svg width="' + size + '" height="' + h + '" viewBox="0 0 ' + it.w + ' ' + it.h + '" shape-rendering="crispEdges" aria-hidden="true"><use href="#' + it.id + '"/></svg>'
          fbox.appendChild(el)
          pool.push(el)
          el.addEventListener('animationend', onFloaterEnd(el))
        }
        function spawnOne(it) {
          var dir = Math.random() < 0.5 ? 'ltr' : 'rtl'
          var top = world() === 'sea' ? 8 + Math.random() * 52 : 5 + Math.random() * 48
          var dur = 24 + Math.random() * 28
          var size = 24 + Math.random() * 30
          var delay = Math.random() * 4
          build(it, dir, top, dur, size, delay, Date.now() + delay * 1000)
          saveState()
        }
        function restoreState() {
          var list = []
          try { list = JSON.parse(sessionStorage.getItem(FLOAT_KEY) || '[]') } catch (e) {}
          if (!list.length) return
          var now = Date.now()
          var lib = LIB[world()]
          for (var i = 0; i < list.length; i++) {
            var s = list[i]
            if (!s || !s.id || !Number.isFinite(s.startAt) || !Number.isFinite(s.dur)) continue
            var it = lib.find(function (x) { return x.id === s.id })
            if (!it) continue
            var elapsed = (now - s.startAt) / 1000
            if (elapsed >= s.dur) continue
            build(it, s.dir, s.top, s.dur, s.size, (s.startAt - now) / 1000, s.startAt)
          }
          saveState()
        }
        function topUp() {
          if (pool.length >= 3) return
          var list = LIB[world()]
          var act = activeIds()
          var avail = shuffle(list.filter(function (it) { return act.indexOf(it.id) === -1 }))
          var n = Math.min(3 - pool.length, avail.length)
          for (var i = 0; i < n; i++) spawnOne(avail[i])
        }
        function clearAll() {
          for (var i = pool.length - 1; i >= 0; i--) {
            var p = pool[i]
            if (p.parentNode) p.parentNode.removeChild(p)
          }
          pool.length = 0
          saveState()
        }
        new MutationObserver(function (muts) {
          muts.forEach(function (m) {
            if (m.type === 'attributes' && m.attributeName === 'data-theme') {
              clearAll()
              setTimeout(topUp, 320)
            }
          })
        }).observe(root, { attributes: true })
        restoreState()
        topUp()
        setInterval(topUp, 9000)
        document.addEventListener('visibilitychange', function () {
          var state = document.hidden ? 'paused' : 'running'
          pool.forEach(function (el) {
            el.style.animationPlayState = state
            var svg = el.firstElementChild
            if (svg) svg.style.animationPlayState = state
          })
        })
      })()
    </script>

    <div class='wrap'>
      <div class='hud-bar'>
        <a class='hud-home' href='/' aria-label='返回首页'>
          <span class='pwr'><i></i>PWR</span>
          <span class='title'>FAMICOM<b> RPG</b> · {site.hudTitle}</span>
        </a>
        <span class='meta'>
          <span class='g' data-stat='gold'>{goldStr}</span>
          <span class='lv hide-s' data-stat='level'>{levelStr}</span>
          <a class='theme-btn' href={site.github} target='_blank' rel='noopener' aria-label='GitHub'>
            <svg width='14' height='14' viewBox='0 0 16 16' shape-rendering='crispEdges' aria-hidden='true'><use href='#pix-octocat'/></svg>
            GITHUB
          </a>
          <button class='theme-btn' id='themeToggle' aria-label='潜入深海世界'>DIVE</button>
        </span>
      </div>

      <slot />

      <footer>
        <a href='/'>■ 返回标题</a>
        <a href='/blog'>冒险记录</a>
        <a href='/about'>勇者档案</a>
        <a href='/logs'>旅行日志</a>
        <a href='/treasure'>道具宝箱</a>
        <a href='/links'>伙伴酒馆</a>
        <a href={site.github} target='_blank' rel='noopener'>GitHub</a>
        <a href={site.poweredBy} target='_blank' rel='noopener'>Powered by Astro</a>
        <span>{site.copyright}</span>
      </footer>
    </div>

    <!-- 天空频道字幕 -->
    <div id='ticker'>
      <div class='ticker-viewport'>
        <span class='ticker-label'>
          <svg class='tl-ic-day' width='16' height='12' viewBox='0 0 12 7' shape-rendering='crispEdges' aria-hidden='true'><use href='#pixel-cloud'/></svg>
          <svg class='tl-ic-night' width='13' height='16' viewBox='0 0 10 12' shape-rendering='crispEdges' aria-hidden='true'><use href='#pixel-bubble'/></svg>
          <span data-world-name>天空频道</span>
        </span>
        <div class='ticker-scroll'>
          <div class='ticker-track' id='tickerTrack'>
            {
              sayings.map((s) => (
                <span class='say-item'>{s}</span>
              ))
            }
            <span>今日 <span class='weather-slot' data-city={site.weatherCity}><b>晴</b></span> · <span data-stat='level'>{levelStr}</span> · <span data-stat='gold'>{goldStr}</span></span>
          </div>
        </div>
        <button class='ticker-close' id='tickerClose'>收起 ▲</button>
      </div>
    </div>
    <button class='ticker-tab' id='tickerTab' aria-label='展开天空频道'>天空频道 ▲</button>

    <svg width='0' height='0' style='position:absolute' aria-hidden='true'>
      <defs>
        <symbol id='pixel-cloud' viewBox='0 0 12 6'>
          <rect x='4' y='0' width='4' height='1' fill='var(--cloud1)'/>
          <rect x='2' y='1' width='8' height='1' fill='var(--cloud1)'/>
          <rect x='0' y='2' width='12' height='2' fill='var(--cloud1)'/>
          <rect x='0' y='4' width='12' height='1' fill='var(--cloud2)'/>
          <rect x='0' y='5' width='12' height='1' fill='var(--cloudsh)'/>
        </symbol>
        <symbol id='pixel-star' viewBox='0 0 5 5'>
          <rect x='2' y='0' width='1' height='1' fill='var(--spark)'/>
          <rect x='1' y='1' width='3' height='1' fill='var(--spark)'/>
          <rect x='0' y='2' width='5' height='1' fill='var(--spark)'/>
          <rect x='1' y='3' width='3' height='1' fill='var(--spark)'/>
          <rect x='2' y='4' width='1' height='1' fill='var(--spark)'/>
        </symbol>
        <symbol id='pixel-shroom' viewBox='0 0 8 7'>
          <rect x='2' y='0' width='4' height='1' fill='#d63a45'/>
          <rect x='1' y='1' width='6' height='2' fill='#d63a45'/>
          <rect x='0' y='3' width='8' height='1' fill='#d63a45'/>
          <rect x='2' y='2' width='1' height='1' fill='#fff8ec'/>
          <rect x='5' y='2' width='1' height='1' fill='#fff8ec'/>
          <rect x='3' y='4' width='2' height='1' fill='#f2e2c4'/>
          <rect x='2' y='5' width='4' height='2' fill='#f2e2c4'/>
        </symbol>
        <symbol id='pixel-coin' viewBox='0 0 6 6'>
          <rect x='1' y='0' width='4' height='1' fill='#c8861f'/>
          <rect x='0' y='1' width='6' height='4' fill='#e9a13b'/>
          <rect x='1' y='1' width='4' height='4' fill='#ffd84d'/>
          <rect x='2' y='2' width='2' height='2' fill='#e9a13b'/>
          <rect x='1' y='5' width='4' height='1' fill='#c8861f'/>
        </symbol>
        <symbol id='pixel-heart' viewBox='0 0 7 6'>
          <rect x='1' y='0' width='2' height='1' fill='#d63a45'/>
          <rect x='4' y='0' width='2' height='1' fill='#d63a45'/>
          <rect x='0' y='1' width='7' height='1' fill='#d63a45'/>
          <rect x='1' y='1' width='1' height='1' fill='#e05560'/>
          <rect x='0' y='2' width='7' height='1' fill='#d63a45'/>
          <rect x='1' y='3' width='5' height='1' fill='#d63a45'/>
          <rect x='2' y='4' width='3' height='1' fill='#d63a45'/>
          <rect x='3' y='5' width='1' height='1' fill='#b22a33'/>
        </symbol>
        <symbol id='pixel-fish' viewBox='0 0 10 6'>
          <rect x='2' y='0' width='3' height='1' fill='var(--fish)'/>
