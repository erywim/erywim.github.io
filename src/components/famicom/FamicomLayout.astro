</html>

<script>
  // —— 昼夜切换：整页潜入深海 / 升上天空之城 ——
  const root = document.documentElement
  const tb = document.getElementById('themeToggle') as HTMLButtonElement | null
  const DIVE_MS = 1700
  const SWAP_AT = 430
  let diving = false
  const RM =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // 后台标签页：给 <html> 打 data-hidden 标记，配合 CSS 冻结所有动画，
  // 避免切换回来时 steps()/长动画时间轴跳帧导致组件局部闪屏
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) root.setAttribute('data-hidden', '')
    else root.removeAttribute('data-hidden')
  })

  function setTheme(night: boolean) {
    if (night) root.setAttribute('data-theme', 'night')
    else root.removeAttribute('data-theme')
    try {
      localStorage.setItem('cq-theme', night ? 'night' : 'day')
    } catch (e) {}
    paint()
  }
  function paint() {
    const n = root.getAttribute('data-theme') === 'night'
    if (tb) {
      tb.textContent = n ? 'RISE' : 'DIVE'
      tb.setAttribute('aria-label', n ? '升上天空之城' : '潜入深海世界')
    }
    const tc = document.querySelector('meta[name="theme-color"]')
    if (tc) tc.setAttribute('content', n ? '#16485e' : '#7cc4f2')
    const wm = document.querySelectorAll('[data-world-name]')
    wm.forEach((el) => {
      el.textContent = n ? '深海频道' : '天空频道'
    })
  }
  if (tb) {
    tb.addEventListener('click', () => {
      if (diving) return
      const toNight = root.getAttribute('data-theme') !== 'night'
      diving = true
      tb.disabled = true
      if (RM) {
        setTheme(toNight)
        diving = false
        tb.disabled = false
        return
      }
      document.body.classList.add('dive', toNight ? 'to-night' : 'to-day')
      // 每个面板分配错峰序号 + 随机偏移/旋转
      const kids = document.querySelectorAll('.wrap > *')
      const total = kids.length
      kids.forEach((kid, i) => {
        // 下潜(→夜)按 DOM 顺序自上而下；上浮(→昼)反向自下而上
        const ri = toNight ? i : total - 1 - i
        ;(kid as HTMLElement).style.setProperty('--ri', String(ri))
        ;(kid as HTMLElement).style.setProperty('--sx', (Math.random() * 40 - 20).toFixed(0) + 'px')
        ;(kid as HTMLElement).style.setProperty('--rz', (Math.random() * 4 - 2).toFixed(1) + 'deg')
      })
      setTimeout(() => {
        setTheme(toNight)
      }, SWAP_AT)
      setTimeout(() => {
        document.body.classList.add('build')
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.body.classList.add('land')
          })
        })
      }, 700)
      setTimeout(() => {
        document.body.classList.remove('dive', 'to-night', 'to-day', 'build', 'land')
        kids.forEach((kid) => {
          ;(kid as HTMLElement).style.removeProperty('--ri')
          ;(kid as HTMLElement).style.removeProperty('--sx')
          ;(kid as HTMLElement).style.removeProperty('--rz')
        })
        diving = false
        tb.disabled = false
      }, DIVE_MS)
    })
    paint()
  }

  // —— 视差（rAF 节流，避免 mousemove 高频触发重排） ——
  const fx = document.getElementById('skyfx')
  if (fx) {
    let parId = 0
    window.addEventListener('mousemove', (e) => {
      if (parId) return
      parId = requestAnimationFrame(() => {
        parId = 0
        const x = e.clientX / window.innerWidth - 0.5
        const y = e.clientY / window.innerHeight - 0.5
        fx.style.setProperty('--mx', (x * 18).toFixed(1) + 'px')
        fx.style.setProperty('--my', (y * 10).toFixed(1) + 'px')
      })
    })
    const layers = fx.querySelectorAll('.layer')
    const mx = [-0.5, -1, -1.8]
    const my = [-0.4, -0.7, -1.1]
    layers.forEach((l, i) => {
      ;(l as HTMLElement).style.transform = `translate(calc(var(--mx,0px) * ${mx[i]}), calc(var(--my,0px) * ${my[i]}))`
    })
  }

  // 漂浮物已提前到内联脚本（首绘前生成，见上方 <script is:inline>），避免重页加载慢导致“迟到”。

  // —— 背景点击反馈：深海泡泡上飘 / 天空云絮星尘 ——
  const sfx = document.getElementById('skyfx')!
  if (sfx) {
    const BGRM =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isNight = () => root.getAttribute('data-theme') === 'night'
    function make(
      cls: string,
      id: string,
      vw: number,
      vh: number,
      w: number,
      h: number,
      x: number,
      y: number,
      sx?: number
    ) {
      const el = document.createElement('span')
      el.className = 'bgpop ' + cls
      el.style.left = x - Math.round(w / 2) + 'px'
      el.style.top = y - Math.round(h / 2) + 'px'
      el.style.width = w + 'px'
      el.style.height = h + 'px'
      el.innerHTML = `<svg width="${w}" height="${h}" viewBox="0 0 ${vw} ${vh}" shape-rendering="crispEdges" aria-hidden="true"><use href="#${id}"/></svg>`
      if (sx !== undefined) el.style.setProperty('--sx', sx + 'px')
      sfx.appendChild(el)
      if (BGRM) {
        el.style.animation = 'none'
        el.style.opacity = '0'
      }
      el.addEventListener('animationend', () => {
        if (el.parentNode) el.parentNode.removeChild(el)
      })
    }
    function pop(x: number, y: number) {
      if (isNight()) {
        make('bubble', 'pixel-bubble', 10, 12, 22, 26, x, y + 10)
        make('bubble', 'pixel-bubble', 10, 12, 14, 17, x + 18, y - 4)
        make('bubble', 'pixel-bubble', 10, 12, 10, 12, x - 20, y + 20)
      } else {
        make('wisp', 'pixel-wisp', 14, 8, 42, 24, x, y + 8)
        make('spark', 'pixel-star', 5, 5, 12, 12, x + 28, y + 16, 14)
        make('spark', 'pixel-star', 5, 5, 9, 9, x - 30, y + 4, -12)
      }
    }
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement
      if (!t || t.nodeType !== 1) return
      if (
        t.closest(
          'a,button,input,select,textarea,.area-chip,#toTop,#ticker,#progress,.px,.cmd-menu,.hud-bar,footer,.dialogue,.title-screen,.fortune-cup,.fortune-btn,.press-start'
        )
      )
        return
      if (
        t === document.body ||
        t === document.documentElement ||
        (t.classList && t.classList.contains('wrap')) ||
        t.id === 'sky' ||
        t.id === 'skyfx' ||
        (t.closest && t.closest('#skyfx') && !t.closest('.area-chip'))
      ) {
        pop(e.clientX, e.clientY)
      }
    })
  }

  // —— 滚动显现 ——
  if (!('IntersectionObserver' in window)) {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'))
  }
  const io = new IntersectionObserver(
    (es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in')
          io.unobserve(e.target)
        }
      })
    },
    { threshold: 0.06 }
  )
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el))

  // —— 天空频道：双份内容无缝滚动 + 收起/展开 ——
  const track = document.getElementById('tickerTrack')
  if (track) {
    // 语料随机抽取打乱，每 3 条语料重播一次天气，语料间用像素图分隔，双份内容无缝滚动
    const says = Array.from(track.querySelectorAll('.say-item')).map((el) => el.textContent || '')
    const weather = track.querySelector('.weather-slot')?.parentElement?.outerHTML || ''
    for (let i = says.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[says[i], says[j]] = [says[j], says[i]]
    }
    const picked = says.slice(0, 9) // 9 条语料 → 每 3 条插 1 次天气，共 3 次
    const seps = ['pixel-star', 'pixel-shroom', 'pixel-coin', 'pixel-heart']
    const sepOf = (i: number) =>
      `<svg class='ticker-sep' width='12' height='12' viewBox='0 0 12 12' shape-rendering='crispEdges' aria-hidden='true'><use href='#${seps[i % seps.length]}'/></svg>`
    let part = ''
    let k = 0
    picked.forEach((s, i) => {
      part += `<span>${s}</span>` + sepOf(k++)
      if ((i + 1) % 3 === 0) part += weather + sepOf(k++) // 每 3 条语料重播一次天气
    })
    track.innerHTML = part + part
  }
  const tkc = document.getElementById('tickerClose')
  const tkt = document.getElementById('tickerTab')
  if (tkc) {
    tkc.addEventListener('click', () => {
      const tk = document.getElementById('ticker')
      if (tk) tk.style.display = 'none'
      if (tkt) tkt.classList.add('show')
    })
  }
  if (tkt) {
    tkt.addEventListener('click', () => {
      const tk = document.getElementById('ticker')
      if (tk) tk.style.display = ''
      tkt.classList.remove('show')
    })
  }

  // —— 今日天气：多源 IP 定位 → open-meteo 天气；全失败兜底到配置城市 ——
  const weatherSlots = document.querySelectorAll<HTMLElement>('.weather-slot')
  const fallbackCity = weatherSlots[0]?.dataset.city || ''
  const WX_TTL = 30 * 60 * 1000
  const WX_DESC: Record<number, string> = {
    0: '晴', 1: '晴间多云', 2: '多云', 3: '阴',
    45: '雾', 48: '雾凇',
    51: '毛毛雨', 53: '毛毛雨', 55: '毛毛雨',
    56: '冻毛毛雨', 57: '冻毛毛雨',
    61: '小雨', 63: '中雨', 65: '大雨',
    66: '冻雨', 67: '冻雨',
    71: '小雪', 73: '中雪', 75: '大雪',
    77: '雪粒',
    80: '阵雨', 81: '阵雨', 82: '强阵雨',
    85: '阵雪', 86: '阵雪',
    95: '雷阵雨', 96: '雷暴伴冰雹', 99: '雷暴伴冰雹'
  }
  // ipwho.is / ipinfo.io 返回英文城市名，常用城市转中文，未知城市保留原名
  const WX_CITY: Record<string, string> = {
    Beijing: '北京', Shanghai: '上海', Guangzhou: '广州', Shenzhen: '深圳',
    Hangzhou: '杭州', Nanjing: '南京', Suzhou: '苏州', Chengdu: '成都',
    Chongqing: '重庆', Wuhan: '武汉', "Xi'an": '西安', Tianjin: '天津',
    Changsha: '长沙', Qingdao: '青岛', Dalian: '大连', Xiamen: '厦门',
    Fuzhou: '福州', Zhengzhou: '郑州', Hefei: '合肥', Kunming: '昆明',
    Shenyang: '沈阳', Harbin: '哈尔滨', Changchun: '长春', Jinan: '济南',
    Nanchang: '南昌', Guiyang: '贵阳', Nanning: '南宁', Haikou: '海口',
    Sanya: '三亚', Lanzhou: '兰州', Urumqi: '乌鲁木齐', Hohhot: '呼和浩特',
    Yinchuan: '银川', Xining: '西宁', Lhasa: '拉萨', Taiyuan: '太原',
    Shijiazhuang: '石家庄', 'Hong Kong': '香港', Macau: '澳门', Taipei: '台北'
  }
  const setWeather = (html: string) => weatherSlots.forEach((el) => (el.innerHTML = html))
  // 带超时的 fetch，避免请求挂起导致占位迟迟不更新
  const fetchTimeout = (url: string, ms: number) => {
    const c = new AbortController()
    const t = setTimeout(() => c.abort(), ms)
    return fetch(url, { signal: c.signal }).finally(() => clearTimeout(t))
  }
  // 定位任务：成功才 resolve，失败/无效一律 reject，供 Promise.any 取最快成功者
  const geoJob = (p: Promise<{ lat: number; lon: number; city: string } | null>) =>
    p.then(
      (v) => (v ? v : Promise.reject(new Error('empty'))),
      () => Promise.reject(new Error('fail'))
    )

  async function findLocation(): Promise<{ lat: number; lon: number; city: string } | null> {
    const jobs = [
      geoJob(fetchTimeout('https://ipwho.is/', 4000).then((r) => r.json()).then((g: any) =>
        g?.success && g.latitude != null && g.longitude != null
          ? { lat: g.latitude, lon: g.longitude, city: WX_CITY[g.city] || g.city || '' }
          : null)),
      geoJob(fetchTimeout('https://ip-api.com/json/?lang=zh-CN', 4000).then((r) => r.json()).then((g: any) =>
        g?.status === 'success' && g.lat != null && g.lon != null
          ? { lat: g.lat, lon: g.lon, city: g.city || '' }
          : null)),
      geoJob(fetchTimeout('https://ipinfo.io/json', 4000).then((r) => r.json()).then((g: any) => {
        if (!g?.loc) return null
        const [lat, lon] = String(g.loc).split(',').map(Number)
        return { lat, lon, city: WX_CITY[g.city] || g.city || '' }
      }))
    ]
    try {
      return await Promise.any(jobs)
    } catch (e) {
      return null
    }
  }

  async function loadWeather() {
    try {
      const cached = localStorage.getItem('erywim-wx')
      if (cached) {
        const { at, html } = JSON.parse(cached) as { at: number; html: string }
        if (Date.now() - at < WX_TTL) {
          setWeather(html)
          return
        }
      }
      let loc = await findLocation()
      if (!loc) {
        // 多源定位全失败（如走代理被拦截）：兜底显示配置城市
        if (!fallbackCity) return
        const gc = (await (await fetchTimeout(
          'https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(fallbackCity) + '&count=1&language=zh',
          5000
        )).json()) as { results?: Array<{ latitude?: number; longitude?: number }> }
        if (!gc?.results?.[0]?.latitude || !gc?.results?.[0]?.longitude) return
        loc = { lat: gc.results[0].latitude, lon: gc.results[0].longitude, city: fallbackCity }
      }
      const q = new URLSearchParams({
        latitude: String(loc.lat),
        longitude: String(loc.lon),
        current: 'temperature_2m,weather_code',
        daily: 'temperature_2m_max,temperature_2m_min',
        timezone: 'auto'
      })
      const wx = (await (await fetchTimeout('https://api.open-meteo.com/v1/forecast?' + q, 5000)).json()) as {
        current?: { temperature_2m?: number; weather_code?: number }
        daily?: { temperature_2m_max?: number[]; temperature_2m_min?: number[] }
      }
      const temp = Math.round(wx.current?.temperature_2m ?? NaN)
      if (Number.isNaN(temp)) return
      const desc = WX_DESC[wx.current?.weather_code ?? 0] ?? '未知'
      let html = (loc.city ? `<i>${loc.city}</i> ` : '') + `${desc} <b>${temp}°C</b>`
      const hi = Math.round(wx.daily?.temperature_2m_max?.[0] ?? NaN)
      const lo = Math.round(wx.daily?.temperature_2m_min?.[0] ?? NaN)
      if (!Number.isNaN(hi)) html += ` ↑${hi}°`
      if (!Number.isNaN(lo)) html += ` ↓${lo}°`
      setWeather(html)
      try {
        localStorage.setItem('erywim-wx', JSON.stringify({ at: Date.now(), html }))
      } catch (e) {}
    } catch (e) {
      /* 网络失败 / 请求被拦截：保留默认「晴」，静默降级 */
    }
  }
  if (weatherSlots.length) loadWeather()

  // —— 阅读进度 + 回到顶部 ——
  const prog = document.getElementById('progress')
  const tot = document.getElementById('toTop')
  function onScroll() {
    const h = document.documentElement
    const max = h.scrollHeight - h.clientHeight || 1
    if (prog) prog.style.width = (h.scrollTop / max) * 100 + '%'
    if (tot) {
      if (h.scrollTop > 500) tot.classList.add('show')
      else tot.classList.remove('show')
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()
  if (tot) {
    tot.addEventListener('click', (e) => {
      e.preventDefault()
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  }

  // —— 命令菜单：方向键移动 + A/Enter 确定 ——
  const menu = document.querySelector<HTMLElement>('.cmd-menu')
  if (menu) {
    const items = Array.from(menu.querySelectorAll('a'))
    menu.addEventListener('keydown', (e: KeyboardEvent) => {
      const idx = items.indexOf(document.activeElement as HTMLAnchorElement)
      if (idx < 0) return
      let to = null
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = (idx + 1) % items.length
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = (idx - 1 + items.length) % items.length
      if (to != null) {
        e.preventDefault()
        items[to].focus()
      } else if (e.key.toLowerCase() === 'a') {
        e.preventDefault()
        ;(document.activeElement as HTMLElement).click()
      }
    })
  }

  // —— RPG 掉落：异步求和 + 每日缓存 + 滚动回显 ——
  const rpgNode = document.getElementById('rpg-quest-data')
  if (rpgNode) {
    let quests: { gold: number; exp: number }[] | null = null
    let titles: { level: number; title: string }[] = []
    try {
      const data = JSON.parse(rpgNode.textContent || '')
      quests = data.quests ?? null
      titles = data.titles ?? []
    } catch {}
    if (quests && titles.length) {
      const RPG_KEY = 'erywim-rpg-stats'
      const rpgEls = Array.from(document.querySelectorAll<HTMLElement>('[data-stat]'))
      const titleEls = Array.from(document.querySelectorAll<HTMLElement>('[data-rpg-title]'))
      const RPG_RM =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function fmtRpg(el: HTMLElement, v: number): string {
        if (el.dataset.stat === 'gold') {
          return el.hasAttribute('data-lite') ? `G${v}` : `G ${String(v).padStart(4, '0')}`
        }
        if (el.dataset.stat === 'exp') return String(v)
        return `LV.${v}`
      }

      function statOf(el: HTMLElement, s: { gold: number; exp: number; level: number }): number {
        if (el.dataset.stat === 'gold') return s.gold
        if (el.dataset.stat === 'exp') return s.exp
        return s.level
      }

      function getTitle(lv: number): string {
        let t = titles[0].title
        for (const it of titles) if (lv >= it.level) t = it.title
        return t
      }

      function rollRpg(el: HTMLElement, to: number, dur = 1100) {
        if (RPG_RM) {
          el.textContent = fmtRpg(el, to)
          return
        }
        const from = Number((el.textContent || '').replace(/\D/g, '')) || 0
        const t0 = performance.now()
        function step(ts: number) {
          const p = Math.min((ts - t0) / dur, 1)
          const v = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3)))
          el.textContent = fmtRpg(el, v)
          if (p < 1) requestAnimationFrame(step)
        }
        requestAnimationFrame(step)
      }

      async function loadRpg() {
        // 本地日期（不用 toISOString，避免 UTC 日期偏移）
        const d = new Date()
        const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
          d.getDate()
        ).padStart(2, '0')}`
        let cached: { date?: string; gold?: number; exp?: number } | null = null
        try {
          cached = JSON.parse(localStorage.getItem(RPG_KEY) ?? 'null')
        } catch {}
        let target: { gold: number; exp: number }
        if (
          cached &&
          cached.date === today &&
          typeof cached.gold === 'number' &&
          typeof cached.exp === 'number'
        ) {
          // 当天已统计过 → 直接用缓存
          target = { gold: cached.gold, exp: cached.exp }
        } else {
          // 当天首次 → 才真正统计：让出主线程后逐篇求和（不阻塞渲染）
          await new Promise((r) => setTimeout(r, 0))
          let gold = 0
          let exp = 0
          for (const q of quests!) {
            gold += q.gold
            exp += q.exp
          }
          target = { gold, exp }
          try {
            localStorage.setItem(RPG_KEY, JSON.stringify({ date: today, ...target }))
          } catch {}
        }
        const level = Math.min(100, Math.max(1, Math.floor(target.exp / 100) + 1))
        for (const el of rpgEls) rollRpg(el, statOf(el, { ...target, level }))
        // 称号随等级回显（与服务端兜底值一致，加一次像素闪烁揭示动画）
        for (const el of titleEls) {
          el.textContent = getTitle(level)
          el.classList.add('title-gain')
        }
      }

      loadRpg()
    }
  }

  // —— HP/MP 体力随时间递减：6:00 满 100 → 24:00 线性降；HP 剩 10、MP 剩 30，曲线不同 ——
  const hpEls = Array.from(document.querySelectorAll<HTMLElement>('[data-live-hp]'))
  const mpEls = Array.from(document.querySelectorAll<HTMLElement>('[data-live-mp]'))
  const hpBars = Array.from(document.querySelectorAll<HTMLElement>('[data-live-hp-bar]'))
  const mpBars = Array.from(document.querySelectorAll<HTMLElement>('[data-live-mp-bar]'))

  function staminaNow(d: Date, end = 10): number {
    const mins = d.getHours() * 60 + d.getMinutes()
    if (mins < 360) return end
    const span = 1440 - 360 // 6:00 → 24:00 共 1080 分钟
    const elapsed = mins - 360
    return Math.round(100 - ((100 - end) * elapsed) / span)
  }

  function rollNum(el: HTMLElement, to: number, dur = 900) {
    const from = Number((el.textContent || '').replace(/\D/g, '')) || 0
    if (from === to) return
    const t0 = performance.now()
    function step(ts: number) {
      const p = Math.min((ts - t0) / dur, 1)
      el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3))))
      if (p < 1) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  }

  if (hpEls.length || mpEls.length) {
    function updateVitals() {
      const hp = staminaNow(new Date(), 10)
      const mp = staminaNow(new Date(), 30) // MP 更耐久，曲线与 HP 不同
      hpEls.forEach((el) => rollNum(el, hp))
      mpEls.forEach((el) => rollNum(el, mp))
      // 条宽统一改 --w（条读 .in .stat-bar i 的 width: var(--w)）：
      // 首绘即用真实值覆盖构建期兜底值，避免构建时间在夜间时血条先显示成一截短条；
      // 同时保留面板 reveal 时的填充动画，之后随体力下降平滑过渡
      hpBars.forEach((el) => {
        el.style.setProperty('--w', hp + '%')
      })
      mpBars.forEach((el) => {
        el.style.setProperty('--w', mp + '%')
      })
    }
    updateVitals()
    setInterval(updateVitals, 30000)
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) updateVitals()
    })
    window.addEventListener('focus', updateVitals)
  }
</script>
