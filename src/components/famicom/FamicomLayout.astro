    </symbol>
    <symbol id="pixel-feather" viewBox="0 0 10 16">
      <rect x="4" y="0" width="2" height="1" fill="var(--cloud1)"/>
      <rect x="3" y="1" width="4" height="1" fill="var(--cloud1)"/>
      <rect x="2" y="2" width="6" height="1" fill="var(--cloud1)"/>
