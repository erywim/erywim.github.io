      <rect x="6" y="11" width="2" height="1" fill="var(--line)"/>
      <rect x="5" y="12" width="4" height="1" fill="var(--cyan)"/>
      <rect x="6" y="13" width="2" height="1" fill="var(--line)"/>
    </symbol>
    <symbol id="pixel-lantern" viewBox="0 0 10 13">
      <rect x="4" y="0" width="2" height="1" fill="var(--gold)"/>
      <rect x="3" y="1" width="4" height="1" fill="var(--gold)"/>
      <rect x="2" y="2" width="6" height="1" fill="var(--gold)"/>
      <rect x="1" y="3" width="8" height="1" fill="var(--accent)"/>
      <rect x="1" y="4" width="8" height="3" fill="var(--accent)"/>
