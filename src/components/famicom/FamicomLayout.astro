        <svg class='cl cl-b' style='top:58%;left:12%;width:160px;opacity:.7'><use href='#pixel-cloud'/></svg>
        <svg class='cl cl-b' style='top:32%;left:70%;width:130px;opacity:.5'><use href='#pixel-cloud'/></svg>
      </div>
      <div class='layer layer-2 skyclouds'>
        <svg class='cl cl-c' style='top:26%;left:8%;width:150px;opacity:.85'><use href='#pixel-cloud'/></svg>
        <svg class='cl cl-c' style='top:70%;left:40%;width:180px;opacity:.9'><use href='#pixel-cloud'/></svg>
        <svg class='cl cl-d' style='top:44%;left:80%;width:120px;opacity:.75'><use href='#pixel-cloud'/></svg>
      </div>
      <div class='layer layer-3 skyclouds'>
        <svg class='cl cl-d' style='top:64%;left:24%;width:210px;opacity:.95'><use href='#pixel-cloud'/></svg>
        <svg class='cl cl-c' style='top:40%;left:52%;width:150px;opacity:.8'><use href='#pixel-cloud'/></svg>
      </div>
      <svg class='spark' style='top:18%;left:18%;width:12px'><use href='#pixel-star'/></svg>
      <svg class='spark' style='top:30%;left:86%;width:14px'><use href='#pixel-star'/></svg>
      <svg class='spark' style='top:52%;left:6%;width:10px'><use href='#pixel-star'/></svg>
      <svg class='spark' style='top:64%;left:94%;width:12px'><use href='#pixel-star'/></svg>
      <svg class='spark' style='top:22%;left:62%;width:9px'><use href='#pixel-star'/></svg>
      <svg class='spark' style='top:74%;left:70%;width:10px'><use href='#pixel-star'/></svg>
      <!-- 天空之城：漂浮岛 + 白鸽 -->
