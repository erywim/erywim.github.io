      <rect x="2" y="11" width="1" height="4" fill="#b22a33"/>
      <rect x="1" y="15" width="3" height="1" fill="#e9a13b"/>
    </symbol>
    <symbol id="pixel-sword-h" viewBox="0 0 16 5">
