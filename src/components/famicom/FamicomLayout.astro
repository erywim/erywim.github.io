      <rect x="8" y="4" width="1" height="1" fill="#cfd9ec"/>
    </symbol>
    <symbol id="pixel-isle" viewBox="0 0 26 18">
      <rect x="8" y="1" width="10" height="1" fill="var(--isle-roof)"/>
      <rect x="9" y="2" width="8" height="1" fill="var(--isle-bldg)"/>
      <rect x="10" y="3" width="6" height="4" fill="var(--isle-bldg)"/>
