      <rect x="1" y="11" width="1" height="1" fill="var(--bubble)"/>
    </symbol>
    <symbol id="pixel-kelp" viewBox="0 0 8 18">
      <rect x="1" y="0" width="2" height="12" fill="var(--kelp)"/>
