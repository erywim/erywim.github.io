      <rect x="3" y="9" width="6" height="1" fill="var(--accent)"/>
      <rect x="4" y="10" width="4" height="1" fill="var(--accent)"/>
      <rect x="5" y="11" width="2" height="1" fill="var(--line)"/>
      <rect x="5" y="12" width="2" height="1" fill="var(--line)"/>
      <rect x="4" y="13" width="4" height="2" fill="var(--gold)"/>
      <rect x="3" y="14" width="6" height="1" fill="var(--gold)"/>
    </symbol>
    <symbol id="pixel-kite" viewBox="0 0 14 14">
      <rect x="6" y="0" width="2" height="1" fill="var(--accent)"/>
      <rect x="5" y="1" width="4" height="1" fill="var(--accent)"/>
