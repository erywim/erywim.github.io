---
import { getCollection } from 'astro:content'

import { CATEGORIES, CHESTS, TAGS } from '@/data/treasure'

// 把道具词汇表 + 全部道具内联为 JSON，供客户端（首页「换一批」、宝箱页筛选/开箱）读取。
// 与服务端渲染保持同一份数据源。
const items = await getCollection('treasure')

const payload = {
  categories: CATEGORIES,
  tags: TAGS,
  chests: CHESTS,
  items: items.map((i) => ({
    id: i.id,
    icon: i.data.icon,
    rarity: i.data.rarity,
    chest: i.data.chest,
    from: i.data.from,
    title: i.data.title,
    desc: i.data.desc,
    tags: i.data.tags,
    href: i.data.href
  }))
}
---

<div id='treasure-data' hidden>{JSON.stringify(payload)}</div>
